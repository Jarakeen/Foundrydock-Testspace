    def _refresh_mechanics(self) -> None:
        if not hasattr(self, "mechanics_layout"):
            return
        self._clear_layout_widgets(self.mechanics_layout)
        self.mechanics_cards = []
        self.mechanics_card_spans = []
        self._mechanics_card_row_indices = []
        encounter_id = self._encounter_id()
        guide = self._guide_for(encounter_id) if encounter_id else None
        abilities = tuple(getattr(guide, "abilities", ()) or ()) if guide is not None else ()
        self.attack_source.setText(
            f"Encounter DB · {len(abilities)} recorded" if abilities else "Encounter DB · no logs"
        )
        query = self.attack_lookup_input.text().strip().casefold()
        visible = [
            ability for ability in abilities
            if not query or query in ability.name.casefold()
            or query in str(ability.description or "").casefold()
        ]
        pending_short_cards: list[QFrame] = []
        def add_row(cards: list[QFrame], *, full_width: bool = False) -> None:
            row_widget = QWidget(self.mechanics_grid_widget)
            row_layout = QHBoxLayout(row_widget)
            row_layout.setContentsMargins(0, 0, 0, 0)
            row_layout.setSpacing(8)
            for card in cards:
                row_layout.addWidget(card, 1)
            row_widget.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Minimum)
            row_index = self.mechanics_layout.count()
            self.mechanics_layout.addWidget(row_widget)
            self._mechanics_card_row_indices.extend(row_index for _card in cards)

        for ability in visible:
            card = QFrame(self.mechanics_grid_widget)
            card.setProperty("mechanicCard", True)
            card.setSizePolicy(QSizePolicy.Policy.Preferred, QSizePolicy.Policy.Minimum)
            card_layout = QVBoxLayout(card)
            card_layout.setContentsMargins(10, 8, 10, 8)
            card_layout.setSpacing(4)
            card_policy = QSizePolicy(QSizePolicy.Policy.Preferred, QSizePolicy.Policy.Minimum)
            card_policy.setHeightForWidth(card_layout.hasHeightForWidth())
            card.setSizePolicy(card_policy)
            title = QLabel(ability.name)
            title.setProperty("eyebrow", True)
            title.setWordWrap(True)
            title.setSizePolicy(QSizePolicy.Policy.Preferred, QSizePolicy.Policy.Maximum)
            card_layout.addWidget(title)
            description = QLabel(ability.description or "No mechanic description recorded.")
            description.setWordWrap(True)
            description.setSizePolicy(QSizePolicy.Policy.Preferred, QSizePolicy.Policy.Maximum)
            card_layout.addWidget(description)
            # Compact presentation only. Thresholds remain on the timeline;
            # source/assignment records and their existing navigation are retained.
            content_length = len(str(ability.description or ""))
            if content_length >= 105 or len(ability.name) >= 32:
                if pending_short_cards:
                    add_row(pending_short_cards)
                    pending_short_cards = []
                add_row([card], full_width=True)
            else:
                pending_short_cards.append(card)
                if len(pending_short_cards) == 2:
                    add_row(pending_short_cards)
                    pending_short_cards = []
            self.mechanics_cards.append(card)
            self.mechanics_card_spans.append(content_length >= 105 or len(ability.name) >= 32)
        if pending_short_cards:
            add_row(pending_short_cards)
        if visible:
            self.mechanics_detail.setText(f"{len(visible)} recorded mechanics · descriptions from encounter evidence")
        else:
            self.mechanics_detail.setText(
                "No named mechanics match this search."
                if abilities else "No named mechanics are recorded for this stage in the encounter database."
            )
        self.mechanics_grid_widget.setMinimumHeight(0)
        self.mechanics_grid_widget.updateGeometry()
        self._schedule_adaptive_reflow()

