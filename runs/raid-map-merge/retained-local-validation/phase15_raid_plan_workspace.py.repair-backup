    def preserve_sidebar_scroll(self, *, keep_pending=False):
        """Retain the requested offset across a temporary range clamp."""
        bar=self.page_scroll.verticalScrollBar()
        anchor=self._sidebar_scroll_anchor
        if self._sidebar_scroll_value is None or not keep_pending:
            self._sidebar_scroll_value=(anchor if keep_pending and anchor is not None
                and bar.value()==min(anchor,bar.maximum()) else bar.value())
        self._sidebar_scroll_anchor=self._sidebar_scroll_value
        self._sidebar_settle_timer.start(180)
        self._schedule_adaptive_reflow()

    def _cancel_sidebar_scroll_restore(self, *_args):
        self._sidebar_scroll_value=None
        self._sidebar_scroll_anchor=None
        self._sidebar_settle_timer.stop()

    def _restore_sidebar_scroll(self, *_args):
        if self._sidebar_scroll_value is None:return
        bar=self.page_scroll.verticalScrollBar()
        target=min(self._sidebar_scroll_value,bar.maximum())
        # Honor explicit forward scrolling while layouts settle; native range
        # clamps/focus adjustments move backwards and must retain the anchor.
        if bar.value()>target:
            self._sidebar_scroll_value=bar.value()
            self._sidebar_scroll_anchor=bar.value()
            return
        if bar.value()!=target:bar.setValue(target)

    def _finish_sidebar_scroll_restore(self):
        self._restore_sidebar_scroll()
        self._sidebar_scroll_value=None

    def eventFilter(self, watched, event):
        if watched is self.page_scroll.viewport():
            if event.type() == QEvent.Type.Wheel:
                self._cancel_sidebar_scroll_restore()
            elif event.type() == QEvent.Type.Resize:
                # Sidebar hover expands/collapses the *viewport* without always
                # delivering a useful parent resizeEvent. Reflow after Qt settles.
                QTimer.singleShot(0, self, self._apply_responsive_columns)
        return super().eventFilter(watched,event)

    def _schedule_adaptive_reflow(self) -> None:
        if self._adaptive_reflow_pending:
            return
        self._adaptive_reflow_pending = True
        # Wait for the sidebar-induced resize and parent layout to settle before
        # measuring wrapped cards; a zero-delay pass can capture stale widths.
        self._adaptive_reflow_timer.start(40)

    @staticmethod
    def _clear_layout_widgets(layout) -> None:
        """Remove old dynamic cards immediately, before deferred Qt deletion."""
        while layout.count():
            item = layout.takeAt(0)
            widget = item.widget()
            if widget is None:
                continue
            widget.hide()
            widget.setParent(None)
            widget.deleteLater()

    @staticmethod
    def _wrapped_card_height(card: QFrame, width: int) -> int:
        """Use Qt's own wrapped layout, including frame insets and visible items."""
        height = card.heightForWidth(max(1, width)) if card.hasHeightForWidth() else -1
        return height if height >= 0 else card.sizeHint().height()

    @staticmethod
    def _status_card_height(card: QFrame, width: int) -> int:
        """Account for the stacked title, status controls and wrapped detail."""
        layout = card.layout()
        if layout is None:
            return card.minimumSizeHint().height()
        margins = layout.contentsMargins()
        content_width = max(1, width - margins.left() - margins.right())
        heading = layout.itemAt(0).layout() if layout.count() > 0 else None
        heading_height = 0
        if heading is not None:
            icon_width = 0
            title = None
            for index in range(heading.count()):
                widget = heading.itemAt(index).widget()
                if not isinstance(widget, QLabel):
                    continue
                pixmap = widget.pixmap()
                if pixmap is not None and not pixmap.isNull():
                    icon_width += widget.sizeHint().width()
                    heading_height = max(heading_height, widget.sizeHint().height())
                else:
                    title = widget
            if title is not None:
                title_width = max(1, content_width - icon_width - max(0, heading.spacing()))
                title_height = (
                    title.heightForWidth(title_width)
                    if title.hasHeightForWidth()
                    else max(title.minimumSizeHint().height(), title.sizeHint().height())
                )
                heading_height = max(heading_height, title_height)
        controls = layout.itemAt(1).layout() if layout.count() > 1 else None
        controls_height = controls.sizeHint().height() if controls is not None else 0
        detail_item = layout.itemAt(2) if layout.count() > 2 else None
        detail = detail_item.widget() if detail_item is not None else None
        detail_height = 0
        if detail is not None:
            detail_height = (
                detail.heightForWidth(content_width)
                if detail.hasHeightForWidth()
                else max(detail.minimumSizeHint().height(), detail.sizeHint().height())
            )
        return max(
            82,
            margins.top() + margins.bottom() + heading_height + controls_height + detail_height
            + max(0, layout.spacing()) * max(0, layout.count() - 1),
        )

    @staticmethod
    def _widget_height_for_width(widget: QWidget, width: int) -> int:
        if widget.hasHeightForWidth():
            return widget.heightForWidth(max(1, width))
        return max(widget.minimumSizeHint().height(), widget.sizeHint().height())

    def _fit_workspace_panel_height(self, panel: QWidget) -> None:
        """Reserve visible content height without imposing a minimum width."""
        box = panel.layout()
        box.invalidate()
        margins = box.contentsMargins()
        frame = panel.contentsMargins()
        width = max(1, panel.width() - frame.left() - frame.right()
                    - margins.left() - margins.right())
        heights = []
        for index in range(box.count()):
            item = box.itemAt(index)
            widget = item.widget()
            if widget is not None:
                if widget.isHidden():
                    continue
                measured = widget.heightForWidth(width) if widget.hasHeightForWidth() else widget.sizeHint().height()
                heights.append(max(0, widget.minimumHeight(), widget.minimumSizeHint().height(), measured))
            elif item.layout() is not None:
                child = item.layout()
                measured = child.heightForWidth(width) if child.hasHeightForWidth() else child.sizeHint().height()
                heights.append(max(0, child.minimumSize().height(), measured))
        required = (frame.top() + frame.bottom() + margins.top() + margins.bottom()
                    + sum(heights) + max(0, len(heights)-1)*max(0, box.spacing()))
        if box.hasHeightForWidth():
            required = max(required, box.totalHeightForWidth(panel.width()))
        panel.setMinimumHeight(required)
        box.invalidate()
        panel.updateGeometry()

    def _reflow_adaptive_content(self) -> None:
        """Recalculate wrapped card heights after the sidebar changes page width."""
        self._adaptive_reflow_pending = False
        self._sync_raid_plan_frames()
        self._layout_mechanic_timeline_cards()
        # The side rail changes the page viewport without changing the window.
        # Activate the column layout first so Readiness cards are measured at
        # their new width instead of the previous expanded/collapsed width.
        self.columns_layout.invalidate()
        self.columns_layout.activate()
        self._fit_map_to_viewport()
        self.readiness_panel.layout().activate()
        for body in self.readiness_section_bodies.values():
            body.layout().activate()
        # Native height-for-width owns the compact cards. Never retain the old
        # width's minimum or include a hidden pane in the selected pane's height.
        for card in self.mechanics_cards:
            card.setMinimumHeight(0)
            card.layout().invalidate()
            card.updateGeometry()
        for index in range(self.mechanics_layout.count()):
            row = self.mechanics_layout.itemAt(index).widget()
            if row is not None:
                row.setMinimumHeight(0)
                row.layout().invalidate()
                row.updateGeometry()
        self.mechanics_grid_widget.setMinimumHeight(0)
        self.mechanics_panel.setMinimumHeight(0)
        self.mechanics_layout.invalidate()
        self.mechanics_panel.layout().invalidate()
        self.mechanics_grid_widget.updateGeometry()
        self.mechanics_panel.updateGeometry()
        timeline_rows: dict[int, int] = {}
        for row in range(self.timeline_cards_layout.rowCount()):
            self.timeline_cards_layout.setRowMinimumHeight(row, 0)
        for index in range(self.timeline_cards_layout.count()):
            item = self.timeline_cards_layout.itemAt(index)
            card = item.widget()
            if card is None:
                continue
            row, _column, _row_span, _column_span = self.timeline_cards_layout.getItemPosition(index)
            card_layout=card.layout()
            required=self._widget_height_for_width(card,card.width())
            if card_layout is not None and card_layout.hasHeightForWidth():
                required=max(required,card_layout.heightForWidth(card.width())+16)
            timeline_rows[row] = max(
                timeline_rows.get(row, 0), required
            )
        for row, height in timeline_rows.items():
            self.timeline_cards_layout.setRowMinimumHeight(row, height)
        if timeline_rows:
            margins = self.timeline_cards_layout.contentsMargins()
            self.timeline_cards_widget.setFixedHeight(
                margins.top() + margins.bottom() + sum(timeline_rows.values())
                + max(0, len(timeline_rows) - 1) * max(0, self.timeline_cards_layout.verticalSpacing())
            )
        else:
            self.timeline_cards_widget.setMinimumHeight(0)
        for key, group_layout in getattr(self, "_readiness_groups", {}).items():
            if self.readiness_section_bodies[key].isHidden():
                continue
            row_heights = []
            for index in range(group_layout.count()):
                row = group_layout.itemAt(index).widget()
                if row is None:
                    continue
                required = (
                    self._status_card_height(row, row.width())
                    if row.property("readinessStatusCard")
                    else self._widget_height_for_width(row, row.width())
                )
                # The estimates include wrapped text but Qt styles can add a few
                # pixels for frame/control metrics; reserve a small safety inset.
                row.setMinimumHeight(required + 6)
                row_heights.append(row.minimumHeight())
            group_layout.activate()
            body = self.readiness_section_bodies[key]
            body_layout = body.layout()
            margins = body_layout.contentsMargins()
            # Layout margins exclude the styled QFrame's own border insets.
            frame_insets = body.contentsMargins()
            body.setMinimumHeight(
                frame_insets.top() + frame_insets.bottom()
                + margins.top() + margins.bottom() + sum(row_heights)
                + max(0, len(row_heights) - 1) * max(0, body_layout.spacing())
            )
            body.updateGeometry()
        self.timeline_cards_layout.activate()
        self.timeline_panel.layout().activate()
        self.mechanics_layout.activate()
        self.mechanics_panel.layout().activate()
        self.fight_stack.sync_content_height()
        self.fight_panel.layout().activate()
        self.readiness_panel.layout().activate()
        # A selected player's warning pills can increase the Team detail height.
        # Re-measure the child first, then reserve the full Team panel height.
        self.build_summary_panel.layout().activate()
        self.build_summary_panel.updateGeometry()
        self._fit_workspace_panel_height(self.build_summary_panel)
        self._fit_workspace_panel_height(self.team_panel)
        self._fit_workspace_panel_height(self.readiness_panel)
        self.columns_layout.invalidate()
        self.columns_layout.activate()
        body = self.page_scroll.widget()
        body.layout().invalidate()
        body.layout().activate()
        body.updateGeometry()
        self.fight_panel.updateGeometry()
        self.readiness_panel.updateGeometry()
        if self._sidebar_scroll_value is not None:
            QTimer.singleShot(0,self,self._restore_sidebar_scroll)

    @staticmethod
    def _workspace_icon(name: str) -> QIcon:
