        self.table.horizontalHeader().setSectionResizeMode(1, QHeaderView.ResizeMode.Stretch)
        self.table.horizontalHeader().setSectionResizeMode(2, QHeaderView.ResizeMode.ResizeToContents)
        self.table.horizontalHeader().setSectionResizeMode(3, QHeaderView.ResizeMode.ResizeToContents)
        self.table.horizontalHeader().setSectionResizeMode(4, QHeaderView.ResizeMode.Stretch)
        members = {_seat_key(member.seat_id): member for member in plan.members}
        for row, seat in enumerate(RAID_PLAN_SEATS):
            member = members.get(_seat_key(seat))
            values = (
                seat,
                (member.gamertag or member.character_name or "Open seat") if member else "Open seat",
                member.role if member and member.role else "Unknown",
                member.eso_class if member and member.eso_class else "Unknown",
                member.selected_build_name if member and member.selected_build_name else "Build not selected",
            )
            for column, value in enumerate(values):
                item = QTableWidgetItem(value)
                item.setToolTip(value)
                self.table.setItem(row, column, item)
            self.table.setRowHeight(row, 40)
        layout.addWidget(self.table, 1)
        buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Close, parent=self)
        buttons.rejected.connect(self.reject)
        layout.addWidget(buttons)


def _seat_key(value: str) -> str:
    return "-".join(str(value or "").strip().casefold().replace("_", " ").split())


def _seat_role(seat: str) -> str:
    folded = str(seat or "").strip().casefold()
    if folded.startswith("tank"):
        return "Tank"
    if folded.startswith("healer"):
        return "Healer"
    return "DD"


