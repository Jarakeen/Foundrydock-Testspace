    def _fit_map_to_viewport(self) -> None:
        """Budget the square and its controls together, independently of scroll."""
        surface = self.map_surface
        canvas = surface.canvas
        # Measure from content origin, not viewport origin: scrolling must never
        # change the map size. Reserve all visible map controls at current width.
        top = canvas.mapTo(self.page_scroll.widget(), QPoint(0, 0)).y()
        if self._column_mode == "stacked":
            # The Fight section follows Team; fit when scrolled to its header.
            top = canvas.mapTo(self.fight_panel, QPoint(0, 0)).y() + 12
        surface_height = surface.heightForWidth(surface.width())
        controls = max(0, surface_height - canvas.heightForWidth(canvas.width()))
        panel_extra = max(
            0, self.map_panel.sizeHint().height() - surface.sizeHint().height(),
            self.map_panel.layout().totalHeightForWidth(self.map_panel.width()) - surface_height,
        )
        width_budget = getattr(self, "_map_width_budget", Metrics.INLINE_MAP_MAX_SIDE)
        height_budget = max(160,
            self.page_scroll.viewport().height() - top - controls - panel_extra - 12)
        side = max(1, min(width_budget, Metrics.INLINE_MAP_MAX_SIDE, height_budget))
        if canvas.size() != QSize(side, side) or canvas.maximumWidth() != side:
            # Assign both dimensions before Qt places the footer. Waiting for the
            # canvas resizeEvent leaves the row's old height in the layout cache.
            canvas.setFixedSize(side, side)
            surface.layout().itemAt(0).layout().invalidate()
            surface.layout().invalidate()
            surface.updateGeometry()
        # A height-limited square must not leave empty strips inside its panel.
        # The surrounding fight column still owns the full width for details.
        rim = self.map_panel.layout().contentsMargins()
        frame = self.map_panel.contentsMargins()
        panel_width = side + rim.left() + rim.right() + frame.left() + frame.right()
        self.map_panel.setMaximumWidth(panel_width)
        # QFrame's fixed vertical policy otherwise keeps its previous size hint
        # after a width-only sidebar transition, compressing the canvas row.
        surface.setFixedHeight(surface.heightForWidth(side))

    def _apply_responsive_columns(self) -> None:
        """Keep the team, map and readiness readable at the current window width."""
        layout = getattr(self, "columns_layout", None)
        if layout is None or not hasattr(self, "readiness_panel"):
            return
        logical_width = max(0, self.page_scroll.viewport().width())
        # Hover navigation must not flip the column arrangement at a breakpoint.
        # Use expanded-rail width only for the column-mode breakpoint.
        nav = getattr(self.window(), "side_nav", None)
        stable_width = logical_width
        if nav is not None:
            from ui.phase15_side_nav import SIDE_NAV_WIDTH
            stable_width -= max(0, SIDE_NAV_WIDTH - nav.width())
        mode = self._responsive_column_mode(stable_width, self.devicePixelRatioF())
        # Allocate actual viewport width, not widget size hints. Sidebar hover
        # changes this viewport without necessarily resizing the outer page.
        # Reserve the middle column's share on BOTH open and closed sidebar states.
        margins = self.page_scroll.widget().layout().contentsMargins()
        available = max(0, logical_width - margins.left() - margins.right())
        if mode == "wide":
            usable = max(0, available - 2 * layout.horizontalSpacing())
            widths = (usable * 30 // 105, usable * 48 // 105)
            required = (widths[0], widths[1], usable - sum(widths))
        elif mode == "two":
            usable = max(0, available - layout.horizontalSpacing())
            required = (usable * 42 // 100, usable - usable * 42 // 100, 0)
        else:
            required = (0, 0, 0)
        map_available = max(1, available)
        if mode == "wide":
            fight_width = max(1, map_available - 2 * layout.horizontalSpacing()) * 48 // 105
        elif mode == "two":
            fight_width = max(1, map_available - layout.horizontalSpacing()) * 58 // 100
        else:
            fight_width = map_available
        # Use declared insets, never child geometries from the previous mode.
        insets = 0
        for panel in (self.fight_panel, self.map_panel):
            for box in (panel.contentsMargins(), panel.layout().contentsMargins()):
                insets += box.left() + box.right()
        self._map_width_budget = max(1, fight_width - insets)
        for index, width in enumerate(required):
            layout.setColumnMinimumWidth(index, width)
        if mode == self._column_mode:
            layout.invalidate()
            layout.activate()
            self._schedule_adaptive_reflow()
            return
        for index in range(3):
            layout.setColumnStretch(index, 0)
            layout.setRowStretch(index, 0)
        while layout.count():
            layout.takeAt(0)
        if mode == "wide":
            layout.addWidget(self.team_panel, 0, 0, 1, 1, Qt.AlignmentFlag.AlignTop)
            layout.addWidget(self.fight_panel, 0, 1, 1, 1, Qt.AlignmentFlag.AlignTop)
            layout.addWidget(self.readiness_panel, 0, 2, 1, 1, Qt.AlignmentFlag.AlignTop)
            # Keep the roster compact so the fight map gets the broadest column.
            layout.setColumnStretch(0, 30)
            layout.setColumnStretch(1, 48)
            layout.setColumnStretch(2, 27)
        elif mode == "two":
            layout.addWidget(self.team_panel, 0, 0, 1, 1, Qt.AlignmentFlag.AlignTop)
            layout.addWidget(self.fight_panel, 0, 1, 1, 1, Qt.AlignmentFlag.AlignTop)
            layout.addWidget(self.readiness_panel, 1, 0, 1, 2, Qt.AlignmentFlag.AlignTop)
            layout.setColumnStretch(0, 42)
            layout.setColumnStretch(1, 58)
        else:
            layout.addWidget(self.team_panel, 0, 0, 1, 1, Qt.AlignmentFlag.AlignTop)
            layout.addWidget(self.fight_panel, 1, 0, 1, 1, Qt.AlignmentFlag.AlignTop)
            layout.addWidget(self.readiness_panel, 2, 0, 1, 1, Qt.AlignmentFlag.AlignTop)
            layout.setColumnStretch(0, 1)
        self._column_mode = mode
        layout.invalidate()
        layout.activate()
        self._schedule_adaptive_reflow()

    @staticmethod
    def _responsive_column_mode(logical_width: int, scale_factor: float) -> str:
        """Choose columns using display-equivalent width across Windows scaling."""
        display_width = max(0, logical_width) * max(1.0, float(scale_factor))
        return "wide" if display_width >= 1360 else "two" if display_width >= 980 else "stacked"

