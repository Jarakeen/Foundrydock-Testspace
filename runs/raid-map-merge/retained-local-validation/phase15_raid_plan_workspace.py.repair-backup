    def _refresh_map(self) -> None:
        if not hasattr(self, "map_image"):
            return
        stage = self._selected_stage()
        encounter_id = self._encounter_id()
        is_lokke_replay = encounter_id.casefold() == "lokkestiiz"
        if not encounter_id or self.map_surface.board is not None:
            self.map_surface.package_layers.deactivate()
        # The user's Likke library map is the only approved visual transform target.
        # Do not apply its calibration over another boss map or generic fallback.
        self.lokke_layer_controls.setVisible(False)
        if not is_lokke_replay:
            self.lokke_logs_layer.setChecked(False)
            self.lokke_stacks_layer.setChecked(False)
            self.map_surface._layers["eso_logs"] = False
            self.map_surface._layers["crutchalerts"] = False
        if self._lokke_overlay is not None:
            self._lokke_overlay.stop()
            if not is_lokke_replay:
                self._lokke_overlay.set_visible("movement", False)
                self._lokke_overlay.set_visible("stacks", False)
        self.reference_replay_button.hide()  # Superseded by the reference layers in the map viewport.
        if not is_lokke_replay and self._reference_replay is not None:
            self._reference_replay.hide()
            self.reference_replay_button.setText("Show ESO Logs Movement")
        self.map_title.setText(stage.label if stage else "Selected stage map")
        self.fight_stage_caption.setText(stage.label if stage else "Selected stage")
        self._map_source = QPixmap()
        self._has_reviewed_map = False
        self._available_stage_maps = []
        self._selected_map_path = None
        self.boss_icon.setPixmap(
            phase15_ui_icon("map_boss" if encounter_id else "trash").pixmap(24, 24)
        )
        self.boss_icon.setAccessibleName("Boss encounter" if encounter_id else "Raid route stage")
        if not encounter_id:
            self._show_default_planning_map()
            return
        # Package navigation is a read-only presentation. Do not scan every map
        # library or construct the editable board for ordinary phase selection.
        if self.map_surface.board is None:
            try:
                context = stage.context_key if stage else ""
                if self.map_surface.package_layers.bind_context(self.current_plan, context):
                    package = self.map_surface.package_layers.package
                    self._selected_map_path = self.map_surface.package_layers.display_path
                    self._has_reviewed_map = True
                    return
            except (OSError, ValueError, RuntimeError) as exc:
                self.map_surface.package_layers.deactivate()
                self.map_image.setText(f"Boss package unavailable: {exc}")
                return
        stores = (EncounterRaidMapStore(get_user_data_dir()), EncounterRaidMapStore(get_data_dir()))
        candidates: list[tuple[Path, str]] = []
        from services.workshop_map_package_service import load_boss_package, package_asset
        try:
            built_in = load_boss_package(Path(get_resource_path("assets", "raid_maps")), self.current_plan.trial_id, encounter_id)
            if built_in:
                package, directory = built_in
                view = next(v for v in package.views if v.id == package.default_view)
                candidates.append((package_asset(directory, view.preview or view.background), package.label + " · " + view.label))
        except (OSError, ValueError):
            self.map_image.setText("The built-in boss package could not be verified.")
            return
        trial_name = self.current_plan.trial_id.replace("_", " ").title()
        try:
            for store in stores:
                for record in store.list_maps(encounter_id):
                    path = store.resolve_path(record)
                    root = store.data_dir.resolve()
                    if path.is_file() and path.is_relative_to(root):
                        candidates.append((path, record.label))
                for record in store.list_workshop_maps(encounter_id=encounter_id):
                    path = store.resolve_workshop_preview(record)
                    root = store.data_dir.resolve()
                    if path.is_file() and path.is_relative_to(root):
                        candidates.append((path, record.label))
            for record in EncounterRaidMapStore(get_data_dir()).list_bundled_maps(trial=trial_name, encounter=encounter_id):
                if record.path.is_file():
                    candidates.append((record.path, record.label))
        except (OSError, ValueError, RuntimeError):
            self.map_image.setPixmap(QPixmap())
            self.map_image.setText("Saved map records could not be verified.")
            return
        if not candidates:
            self._show_default_planning_map()
            return
        # The saved Raid Plan link is authoritative. Encounter catalog order
        # must never silently replace the image the raid lead just saved.
        if self.current_plan is not None:
            try:
                from services.raid_section_state_service import RaidSectionStateService
                linked_id = RaidSectionStateService().linked_raid_map_id(
                    self.current_plan.plan_id, encounter_id
                )
                if linked_id:
                    user_store = stores[0]
                    selected = next(
                        (record for record in user_store.list_maps(encounter_id)
                         if record.map_id == linked_id), None
                    )
                    if selected is not None:
                        linked_path = user_store.resolve_path(selected)
                        if linked_path.is_file():
                            candidates.insert(0, (linked_path, selected.label))
            except (OSError, ValueError, RuntimeError):
                pass  # Retain existing reviewed candidates if link is unavailable.
        # Keep stable unique candidates. A phase control can select a different
        # map only when its saved label explicitly identifies that flight phase.
        seen_paths: set[str] = set()
        self._available_stage_maps = []
        for candidate_path, candidate_label in candidates:
            identity = str(candidate_path.resolve()).casefold()
            if identity in seen_paths:
                continue
            seen_paths.add(identity)
            self._available_stage_maps.append((candidate_path, candidate_label))
        path, label = self._available_stage_maps[0]
        pixmap = QPixmap(str(path))
        if pixmap.isNull():
            self.map_image.setText("The selected map image could not be decoded.")
            return
        self._map_source = pixmap
        self._selected_map_path = path.resolve()
        self._has_reviewed_map = True
        is_aligned_lokke = False
        if is_lokke_replay and built_in:
            import hashlib
            from services.encounter_board_state_pydantic import load_encounter_board_state
            package, directory = built_in
            background = package_asset(directory, package.views[0].background)
            candidates_for_alignment = [path]
            saved = stores[0].latest_plan_layout(self.current_plan.plan_id, encounter_id)
            if saved:
                saved_payload = load_encounter_board_state(stores[0].resolve_path(saved))
                saved_background = Path(saved_payload.get('background_map', ''))
                if not saved_background.is_absolute():saved_background = stores[0].data_dir / saved_background
                candidates_for_alignment = [saved_background]
            expected = {hashlib.sha256(background.read_bytes()).hexdigest()}
            if package.views[0].preview:
                expected.add(hashlib.sha256(package_asset(directory, package.views[0].preview).read_bytes()).hexdigest())
            is_aligned_lokke = any(candidate.is_file() and hashlib.sha256(candidate.read_bytes()).hexdigest() in expected for candidate in candidates_for_alignment)
        self.lokke_layer_controls.setVisible(is_aligned_lokke)
        if not is_aligned_lokke:
            self.lokke_logs_layer.setChecked(False)
            self.lokke_stacks_layer.setChecked(False)
        self._scale_map_image()

    def _show_default_planning_map(self) -> None:
        """Decorative fallback only; never mark it as a reviewed encounter map."""
        from ui.granite_theme import default_granite_map_path
        self._map_source = QPixmap(str(default_granite_map_path()))
        if self._map_source.isNull():
            self.map_image.setPixmap(QPixmap())
