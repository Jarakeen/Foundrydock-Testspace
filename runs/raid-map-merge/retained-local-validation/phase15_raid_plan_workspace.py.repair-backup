        self.table.horizontalHeader().setSectionResizeMode(0, QHeaderView.ResizeMode.ResizeToContents)
        self.table.horizontalHeader().setSectionResizeMode(1, QHeaderView.ResizeMode.Stretch)
        self.table.horizontalHeader().setSectionResizeMode(2, QHeaderView.ResizeMode.ResizeToContents)
        self.table.horizontalHeader().setSectionResizeMode(3, QHeaderView.ResizeMode.ResizeToContents)
        self._players: list[QLineEdit] = []
        self._roles: list[QComboBox] = []
        self._classes: list[QComboBox] = []
        members = {_seat_key(member.seat_id): member for member in plan.members}
        for row, seat in enumerate(RAID_PLAN_SEATS):
            key = _seat_key(seat)
            member = members.get(key)
            self.table.setItem(row, 0, QTableWidgetItem(seat))
            player = QLineEdit(self.table)
            player.setPlaceholderText("Open seat")
            player.setText((member.gamertag or member.character_name or "") if member else "")
            self.table.setCellWidget(row, 1, player)
            role = QComboBox(self.table)
            role.setEditable(True)
            role.addItems(self._ROLES)
            if member and member.role and role.findText(member.role) < 0:
                role.addItem(member.role)
            role.setCurrentText(member.role if member and member.role else _seat_role(seat))
            self.table.setCellWidget(row, 2, role)
            eso_class = QComboBox(self.table)
            eso_class.setEditable(True)
            eso_class.addItems(self._CLASSES)
            if member and member.eso_class and eso_class.findText(member.eso_class) < 0:
                eso_class.addItem(member.eso_class)
            eso_class.setCurrentText(member.eso_class if member and member.eso_class else "")
            self.table.setCellWidget(row, 3, eso_class)
            self._players.append(player)
            self._roles.append(role)
            self._classes.append(eso_class)
            self.table.setRowHeight(row, 36)
        layout.addWidget(self.table, 1)
        buttons = QDialogButtonBox(
            QDialogButtonBox.StandardButton.Save | QDialogButtonBox.StandardButton.Cancel,
            parent=self,
        )
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        layout.addWidget(buttons)

    def updated_members(self) -> tuple[RaidPlanMember, ...]:
        existing = {_seat_key(member.seat_id): member for member in self._plan.members}
        updated: list[RaidPlanMember] = []
        for index, seat in enumerate(RAID_PLAN_SEATS):
            key = _seat_key(seat)
            old = existing.get(key)
            player = self._players[index].text().strip()
            role = self._roles[index].currentText().strip() or _seat_role(seat)
            eso_class = self._classes[index].currentText().strip() or None
            if old is None:
                if player or eso_class:
                    updated.append(RaidPlanMember(
                        seat_id=key,
                        gamertag=player,
                        role=role or None,
                        eso_class=eso_class,
                    ))
                continue
            old_label = (old.gamertag or old.character_name or "").strip()
            if player == old_label:
                updated.append(replace(old, role=role or None, eso_class=eso_class))
                continue
            if player:
                # A changed free-text name is not proof of the old canonical
                # player/character/build identity. Clear those exact references.
                updated.append(replace(
                    old,
                    gamertag=player,
                    roster_member_id=None,
                    player_id=None,
                    character_id=None,
                    character_name=None,
                    role=role or None,
                    eso_class=eso_class,
                    selected_build_id=None,
                    selected_build_name=None,
                    build_source_kind=None,
                    build_source_name=None,
                    build_source_url=None,
                    candidate_id=None,
                    planned_gear_sets=(),
                    planned_skills=(),
                    planned_mundus=None,
                    endgame_ready_assumed=False,
                    max_passives_override=None,
                    max_non_slottable_cp_override=None,
                    equipment_overrides=(),
                ))
            elif old_label:
                updated.append(replace(
                    old,
                    gamertag="",
                    roster_member_id=None,
                    player_id=None,
                    character_id=None,
                    character_name=None,
                    role=role or None,
                    eso_class=eso_class,
                    selected_build_id=None,
                    selected_build_name=None,
                    build_source_kind=None,
                    build_source_name=None,
                    build_source_url=None,
                    candidate_id=None,
                    planned_gear_sets=(),
                    planned_skills=(),
                    planned_mundus=None,
                    endgame_ready_assumed=False,
                    max_passives_override=None,
                    max_non_slottable_cp_override=None,
                    equipment_overrides=(),
                ))
            else:
                updated.append(replace(old, role=role or None, eso_class=eso_class))
        return tuple(updated)


