    def _header_saved_plan(self):
        if self.current_plan is None:
            QMessageBox.information(self, "Raid Plan", "Load and save a Raid Plan first.")
            return None
        if self.has_pending_changes():
            QMessageBox.information(self, "Save changes first", "Save the current plan before duplicating, exporting or sending it to FD.my.")
            return None
        saved = self.repo.get(self.current_plan.plan_id)
        if saved is None or saved != self.current_plan:
            QMessageBox.warning(self, "Raid Plan changed", "Reload the saved plan before exporting or publishing it.")
            return None
        return saved

    def _edit_header_schedule(self) -> None:
        from ui.components.team_schedule_dialog import TeamScheduleDialog
        if self.current_plan is None or not self.current_plan.team_name:
            QMessageBox.information(self, "Team schedule", "Choose a saved plan linked to an existing team first.")
            return
        dialog = TeamScheduleDialog(get_user_database_path(), self.current_plan.team_name, self)
        if dialog.exec() == QDialog.DialogCode.Accepted:
            self._refresh_summary()

    def _duplicate_header_plan(self) -> None:
        """Copy the saved planning snapshot through its canonical repository."""
        from uuid import uuid4
        plan = self._header_saved_plan()
        if plan is None:
            return
        copied = replace(plan, plan_id=f"plan-{uuid4().hex[:12]}", name=f"{plan.name} — Copy")
        try:
            persisted = self.repo.save(copied, expected=None, must_be_new=True)
            verified = self.repo.get(persisted.plan_id)
            if verified != persisted:
                raise RuntimeError("The copy could not be verified. The original remains unchanged.")
        except Exception as exc:
            QMessageBox.warning(self, "Raid Plan copy not opened", str(exc))
            return
        if self.load_plan(verified.plan_id):
            self.order_saved_status.setText("Saved plan copied. Separate maps and stage assignments were not duplicated.")

    def _export_header_plan(self) -> None:
        """Export the saved plan; never publish unsaved editor state."""
        from services.raid_plan_backup_service import export_raid_plan_backup, load_raid_plan_backup
        plan = self._header_saved_plan()
        if plan is None:
            return

        from ui.components.raid_plan_publishing_dialog import (
            RaidPlanPublishingDialog, DiscordBriefingDialog, run_publishing_job,
        )
        # Formats: Granite Field Guide PDF, Light Print PDF, Excel Raid Operations
        # Workbook, Discord Team Briefing, Raid Plan JSON backup.
        dialog = RaidPlanPublishingDialog(plan_id=plan.plan_id, team_name=plan.team_name or "", parent=self)
        if dialog.exec() != QDialog.DialogCode.Accepted:
            return
        selected = dialog.format.currentText()
        details = dialog.details()
        filename = dialog.destination.text().strip()
        try:
            if selected == "Raid Plan JSON backup":
                destination = export_raid_plan_backup(plan, filename)
                if load_raid_plan_backup(destination) != plan:
                    raise RuntimeError("Export could not be verified.")
                self.order_saved_status.setText(f"Plan exported: {destination.name}")
                return
            from engine.config import get_eso_database_path
            from services.raid_plan_publish_service import read_publish_snapshot, with_publish_artwork, discord_briefing_messages, export_discord_briefing
            from services.raid_plan_granite_pdf_export import GranitePublishTheme, export_raid_plan_pdf
            from services.raid_plan_xlsx_export import export_raid_plan_xlsx
            database = get_user_database_path()
            user_root = get_user_data_dir()
            eso_database = get_eso_database_path()
            icon_roots = (user_root / "artwork" / "skills", get_resource_path("assets", "AbilityIcons", "icons", "128"))
            def prepare():
                snapshot = read_publish_snapshot(database, plan.plan_id)
                if "PDF" in selected:
                    snapshot = with_publish_artwork(snapshot, database=eso_database, icon_roots=icon_roots)
                return snapshot
            snapshot = run_publishing_job(self, _HEADER_PUBLISH_EXECUTOR, prepare)
            if snapshot.plan_id.casefold() != plan.plan_id.casefold():
                raise ValueError("Publishing snapshot does not match selected Raid Plan")
            saved_maps = ()
            if "PDF" in selected:
                from services.raid_plan_publish_map_images import resolve_linked_map_images
                from services.raid_section_state_service import RaidSectionStateService
                from ui.components.raid_plan_publish_map_dialog import RaidPlanPublishMapDialog
                linked_encounters = tuple(RaidSectionStateService(user_root / "raid_section_state.json").raid_map_links(plan.plan_id))
                saved_maps = resolve_linked_map_images(user_root, plan.plan_id, linked_encounters)
                encounters = tuple(stage.context_key for stage in snapshot.stages if stage.context_key.casefold().startswith("boss:"))
                picker = RaidPlanPublishMapDialog(trial_id=plan.trial_id, encounter_ids=encounters, user_data_dir=user_root, assets_dir=get_resource_path("assets", "raid_maps"), saved_maps=saved_maps, parent=self)
                if picker.exec() != QDialog.DialogCode.Accepted:
                    return
                # The picker owns the final export selection, including No image.
                # Saved plan maps were already offered there as the default.
                saved_maps = picker.selected_maps()
            def render():
                if selected == "Excel Raid Operations Workbook":
                    return export_raid_plan_xlsx(snapshot, filename, details=details)
                if selected == "Discord Team Briefing":
                    return export_discord_briefing(snapshot, filename, details=details)
                return export_raid_plan_pdf(snapshot, filename, theme=GranitePublishTheme(
                    edition="granite" if selected == "Granite Field Guide PDF" else "print",
                    cover_team_name=details.team_name, cover_raid_date=details.raid_date or None,
                ), map_images=saved_maps, user_data_dir=user_root)
            destination = run_publishing_job(self, _HEADER_PUBLISH_EXECUTOR, render)
            if not destination.is_file() or not destination.stat().st_size:
                raise RuntimeError("Export did not produce a readable file")
        except Exception as exc:
            QMessageBox.warning(self, "Raid Plan export failed", f"No Raid Plan data was changed.\n\n{exc}")
            return
        self.order_saved_status.setText(f"Exported: {destination.name}")
        if selected == "Discord Team Briefing":
            DiscordBriefingDialog(discord_briefing_messages(snapshot, details=details), self).exec()
        else:
            QMessageBox.information(self,"Raid Plan exported",f"Saved to:\n{destination}\n\nReview Export Completeness for data availability.")

    def _publish_header_plan(self) -> None:
        from services.finch_shared_publish_service import publish_raid_plan_to_finch
        if self._header_publish_future is not None:
            return
        plan = self._header_saved_plan()
        if plan is None:
            return
        self.header_fdmy_button.setEnabled(False)
        self.header_fdmy_button.setText("Sending…")
        self._header_publish_snapshot = plan
        try:
            self._header_publish_future = _HEADER_PUBLISH_EXECUTOR.submit(
                publish_raid_plan_to_finch, database_path=get_user_database_path(),
                raid_plans_path=self.repo.path, plan_id=plan.plan_id)
        except RuntimeError as exc:
            self.header_fdmy_button.setEnabled(True)
            self.header_fdmy_button.setText("Send to FD.my")
            QMessageBox.warning(self, "FD.my publish failed", str(exc))
            return
        self._header_publish_timer.start()

    def _poll_header_publish(self) -> None:
        future = self._header_publish_future
        if future is None or not future.done():
            return
        self._header_publish_timer.stop()
        self._header_publish_future = None
        self.header_fdmy_button.setEnabled(True)
        self.header_fdmy_button.setText("Send to FD.my")
        try:
            result = future.result()
        except Exception as exc:
            self.order_saved_status.setText("FD.my publish did not complete; local plan retained.")
            QMessageBox.warning(self, "FD.my publish failed", str(exc))
            return
        published = self._header_publish_snapshot
        self.header_fdmy_button.setToolTip(f"Last published: {published.name} · {result.updated_at}")
        if self.current_plan == published and not self.has_pending_changes():
            self.order_saved_status.setText(f"FD.my updated · {result.updated_at}")
        else:
