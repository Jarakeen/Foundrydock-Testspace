    def _open_quick_entry(self) -> None:
        """Edit the active plan's twelve seat assignments in a compact dialog."""
        from PySide6.QtWidgets import QMessageBox

        if self.current_plan is None:
            QMessageBox.information(self, "Quick Entry", "Load or save a Raid Plan before assigning its team.")
            return
        if not self.flush_pending_changes():
            return
        latest = self.repo.get(self.current_plan.plan_id)
        if latest is None:
            QMessageBox.warning(self, "Quick Entry", "This Raid Plan is no longer available. Reload it before editing the team.")
            return
        dialog = RaidPlanQuickEntryDialog(latest, self)
        if dialog.exec() != QDialog.DialogCode.Accepted:
            return
        revised = replace(latest, members=dialog.updated_members())
        try:
            saved = self.repo.save(revised, expected=latest)
            verified = self.repo.get(saved.plan_id)
            if verified != saved:
                raise RuntimeError("The team assignments did not read back exactly after saving.")
        except Exception as exc:
            QMessageBox.warning(self, "Team not saved", f"The team changes are still available to retry.\n\n{exc}")
            return
        self.current_plan = verified
        self._refresh_endgame_roster()
        self._refresh_team()
        self._refresh_readiness()
        self._refresh_summary()

    def _open_roster(self) -> None:
        from PySide6.QtWidgets import QMessageBox

        if self.current_plan is None:
            QMessageBox.information(self, "Raid Roster", "Load or save a Raid Plan to view its roster.")
            return
        display_plan = self._selected_context_plan()
        if display_plan is None:
            QMessageBox.warning(self, "Stage context unavailable", "Reload the saved plan before reviewing this stage.")
            return
        stage = self._selected_stage()
        dialog = RaidPlanRosterDialog(display_plan, stage.label if stage else "", self)
        dialog.exec()

    def _open_readiness_checklist(self) -> None:
        """Show one source of truth: the existing stage readiness rows."""
        self._refresh_readiness()
        stage = self._selected_stage() if self.current_plan is not None else None
        title = stage.label if stage is not None else "No saved stage selected"
        rows = []
        for group, layout in self._readiness_groups.items():
            for index in range(layout.count()):
                item = layout.itemAt(index)
                card = item.widget() if item is not None else None
                if card is not None and card.property("readinessStatusCard"):
                    rows.append((
                        group,
                        str(card.property("readinessTitle") or ""),
                        str(card.property("readinessDetail") or ""),
                        str(card.property("readinessStatus") or "Unknown"),
                    ))
        dialog = RaidReadinessChecklistDialog(title, rows, self)
        dialog.groupRequested.connect(self._set_readiness_view)
        dialog.exec()

    def _set_readiness_view(self, key: str) -> None:
        self._readiness_view = key
        if not hasattr(self, "readiness_section_bodies"):
            return
        self.readiness_overview.setVisible(key == "summary")
        for group, body in self.readiness_section_bodies.items():
            body.setVisible(group == key)
            self.readiness_sections[group].setVisible(group == key)
        for group, button in self.readiness_tab_buttons.items():
            button.setChecked(group == key)
        self._schedule_adaptive_reflow()

    def _open_readiness_item(self, group: str, title: str) -> None:
        """Navigate to the relevant action, falling back to its evidence section."""
        actions = {
            "Stage loadouts": self._edit_selected_player_build,
            "Crit / Pen · all players": self._open_offensive_stats,
            "Team buffs & debuffs": self._open_coverage_snapshot,
            "Kill & pull order": self._open_kill_pull_order,
            "Key mechanics & callouts": lambda: self._set_fight_view("mechanics"),
            "Movement plan": self._open_map_workshop,
            "Maps annotated": self._open_map_workshop,
            "Sources & backup plan": lambda: self._open_side_route("encounters"),
        }
        self._set_readiness_view(group)
        action = actions.get(title)
        if action is not None:
            action()

    def _refresh_readiness_overview(self) -> None:
        self._clear_layout_widgets(self.readiness_top_items)
        counts = dict.fromkeys(self.readiness_counts, 0)
        rows = []
        for group, layout in self._readiness_groups.items():
            for index in range(layout.count()):
                row = layout.itemAt(index).widget()
                if row is not None and row.property("readinessStatusCard"):
                    status = row.property("readinessStatus")
                    counts[status] = counts.get(status, 0) + 1
                    rows.append((group, row.property("readinessTitle"), status))
        for status, (label, text) in self.readiness_counts.items():
            label.setText(str(counts[status]))
        total = sum(counts.values())
        covered = counts.get("Covered", 0)
        self.readiness_completion_bar.setRange(0, max(total, 1))
        self.readiness_completion_bar.setValue(covered)
        self.readiness_completion_bar.setFormat(f"{covered} of {total} covered")
        self.readiness_completion_bar.setAccessibleName(
            f"{covered} of {total} planning checks covered"
        )
        self.readiness_attention.setText(f"{total-covered} items need attention")
        # Counts summarize the existing checks, never readiness percentages or observed execution.
        from ui.components.readiness_top_items import prioritized_readiness_items
        top_items = prioritized_readiness_items(rows)
        if not top_items:
            empty = QLabel("No checklist findings for this stage yet.")
            empty.setProperty("subtle", True)
            self.readiness_top_items.addWidget(empty)
        for group, title, status in top_items:
            symbol, status_label, _, _ = READINESS_STATUS_PRESENTATION.get(
                status, READINESS_STATUS_PRESENTATION["Unknown"]
            )
            button = QPushButton()
            button.setProperty("readinessTopLink", True)
            button.setAccessibleName(f"{title}: {status_label}")
            row_layout = QHBoxLayout(button)
            row_layout.setContentsMargins(6, 4, 6, 4)
            row_layout.setSpacing(8)
            badge = ReadinessStatusBadge(symbol, status, size=18)
            row_layout.addWidget(badge)
            row_title = QLabel(title)
            row_title.setProperty("readinessRowTitle", True)
            row_title.setWordWrap(True)
            row_status = QLabel(f"{status_label}  ›")
            row_status.setProperty("readinessSupporting", True)
            row_status.setProperty("itemCovered", status == "Covered")
            row_status.setAlignment(Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)
            row_status.setWordWrap(True)
            for child in (badge, row_title, row_status):
                child.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents, True)
            row_layout.addWidget(row_title, 2)
            row_layout.addWidget(row_status, 1)
            button.setToolTip(f"Open {title} in {group}; current status: {status_label}")
            button.clicked.connect(
                lambda _checked=False, target=group, name=title: self._open_readiness_item(target, name)
            )
            self.readiness_top_items.addWidget(button)
        self._set_readiness_view(self._readiness_view)

    def _refresh_readiness(self) -> None:
        if not hasattr(self, "_readiness_groups"):
            return
        for group_layout in self._readiness_groups.values():
            self._clear_layout_widgets(group_layout)
        self._refresh_readiness_overview()
        plan = self._selected_context_plan()
        if plan is None:
            self.readiness_summary.setText(
                "Stage context unavailable · reload the saved plan to retry."
                if self.current_plan is not None else
                "Create or load a saved plan. Readiness will use only its saved evidence."
            )
            self._schedule_adaptive_reflow()
            return
        assigned = [member for member in plan.members if member.gamertag or member.character_id or member.character_name]
        role_counts = {"tank": 0, "healer": 0, "dd": 0}
        for member in plan.members:
            role = str(member.role or "").casefold()
            if "tank" in role:
                role_counts["tank"] += 1
            elif "heal" in role:
                role_counts["healer"] += 1
            elif role in {"dd", "damage", "damage dealer", "support dd"} or "damage" in role:
                role_counts["dd"] += 1
        complete_roles = role_counts == {"tank": 2, "healer": 2, "dd": 8}
        build_count = sum(member.build_selected for member in assigned)
        stage = self._selected_stage()
        self.readiness_summary.setText(f"{stage.label if stage else 'No selected stage'} · planning evidence only")
        self._status_row(self._readiness_groups["group"], "check_circle" if len(assigned) == 12 else "warning", "Players assigned", f"{len(assigned)} of 12 seats have a player or character reference.", "Covered" if len(assigned) == 12 else "Review")
        self._status_row(self._readiness_groups["group"], "users_three", "Roles balanced", f"{role_counts['tank']} tanks / {role_counts['healer']} healers / {role_counts['dd']} DDs recorded.", "Covered" if complete_roles else "Review")
        self._status_row(
            self._readiness_groups["group"], "clipboard_text", "Stage loadouts",
            f"{build_count} assigned players have a saved-build reference. Per-stage item state is reviewed in Builds.",
            "Review" if build_count < len(assigned) else ("Unknown" if not assigned else "Planned"),
            action_text="Edit Build", action=self._edit_selected_player_build,
        )
        assignment_action = QPushButton("Stage assignments")
        assignment_action.setToolTip("Assign portals, house stacks, and other stage duties.")
        assignment_action.clicked.connect(self._open_stage_assignments_dialog)
        self._readiness_groups["group"].addWidget(assignment_action)
        dd_count = sum(1 for member in plan.members if "dd" in str(member.role or "").casefold() or member.seat_id.casefold().startswith("dd"))
        self._status_row(
            self._readiness_groups["group"], "warning_circle", "Crit / Pen · all players",
            f"Review personal stats and stage group support for {dd_count} DD seats.",
            "Review", action_text="Review", action=self._open_offensive_stats,
        )
        providers = len(plan.coverage_providers)
        self._status_row(
            self._readiness_groups["group"], "shield", "Team buffs & debuffs",
            f"{providers} planned provider record(s); delivery, recipient coverage, and uptime are not simulated here.",
            "Review" if providers else "Unknown", action_text="View", action=self._open_coverage_snapshot,
        )
        from services.phase15_assignment_state_service import Phase15AssignmentStateService
        from engine.config import get_user_database_path
        kill_order = (
            Phase15AssignmentStateService.read_snapshot(
                get_user_database_path(), plan.plan_id, stage.context_key
            ) if stage is not None else None
        )
        priorities = kill_order.kill_pull_priorities if kill_order is not None else ()
        preview = " · ".join(
            f"{entry.pull}: {entry.enemy}" for entry in priorities[:3]
        )
        detail = (
            f"{len(priorities)} authored target priorities. {preview}"
            + (" · more in editor" if len(priorities) > 3 else "")
            if priorities else "No authored priorities for this stage. Add pull sequence and target order."
        )
        self._status_row(
            self._readiness_groups["strategy"], "path", "Kill & pull order",
            detail, "Planned" if priorities else "Unknown",
            action_text="Edit order", action=self._open_kill_pull_order,
        )
        self._status_row(
            self._readiness_groups["strategy"], "warning_circle", "Key mechanics & callouts",
            "Mechanics are listed from encounter evidence; raid callouts still need authored notes.",
            "Review" if self._encounter_id() else "Unknown",
            action_text="Mechanics", action=lambda: self._set_fight_view("mechanics"),
        )
        self._status_row(
            self._readiness_groups["strategy"], "arrow_right", "Movement plan",
            "This means saved positions and route arrows on a map. Open the map workspace to review them.",
            "Review", action_text="Map", action=self._open_map_workshop,
        )
        self._status_row(
            self._readiness_groups["resources"], "map_trifold", "Maps annotated",
            "A reviewed image is linked to this stage. Marker annotations and routes are separate map data.",
            "Covered" if self._has_reviewed_map else "Unknown",
            action_text="Open map", action=self._open_map_workshop,
        )
        self._status_row(
            self._readiness_groups["resources"], "info", "Sources & backup plan",
            "Encounter sources are available in Mechanics; a raid-lead backup plan is still an authored decision.",
            "Unknown", action_text="Sources", action=lambda: self._open_side_route("encounters"),
        )
        self._refresh_readiness_overview()
        self._schedule_adaptive_reflow()

    def _on_shared_stage_changed(self, plan_id: str, _context_key: str) -> None:
        if self.current_plan is not None and plan_id.casefold() == self.current_plan.plan_id.casefold():
            self._refresh_bosses()

    def _on_shared_sequence_changed(self, plan_id: str) -> None:
        if self.current_plan is not None and plan_id.casefold() == self.current_plan.plan_id.casefold():
            self._refresh_bosses()

    def _open_map_workshop(self) -> None:
        opener = getattr(self.window(), "_open_side_route", None)
        if callable(opener):
            opener("map_workshop")

    def _open_coverage_snapshot(self) -> None:
        """Open the recovered stage-aware Coverage Inspector in Raid Plan."""
        if self.current_plan is None:
            return
        from ui.components.raid_coverage_inspector_dialog import RaidCoverageInspectorDialog
        RaidCoverageInspectorDialog(self).exec()
        self._refresh_last_saved_footer()

    def _open_kill_pull_order(self) -> None:
        if self.current_plan is None or self._selected_stage() is None:
            return
        if not self.flush_pending_changes():
            return
        from PySide6.QtWidgets import QDialog, QMessageBox
        from ui.components.kill_pull_order_dialog import KillPullOrderDialog
        try:
            dialog = KillPullOrderDialog(self)
            if dialog.exec() == QDialog.DialogCode.Accepted:
                self._refresh_readiness()
        except Exception as exc:
            QMessageBox.warning(self, "Kill & Pull Order", str(exc))

    def _open_offensive_stats(self) -> None:
        if self.current_plan is None or not self.flush_pending_changes():
            return
        from services.build_service import BuildService
        from services.raid_plan_context_offensive_stats_service import (
            RaidPlanContextOffensiveStatsService,
        )

        stage = self._selected_stage()
        context_key = stage.context_key if stage is not None else "general"
        plan_id = self.current_plan.plan_id
        boss_name = stage.label if stage is not None and stage.kind == "boss" else ""

        def calculate():
            saved_builds = BuildService(get_data_dir() / "builds.json").load().Members
            return RaidPlanContextOffensiveStatsService().calculate(
                plan_id, context_key, saved_builds=saved_builds, boss_name=boss_name,
            )

        dialog = RaidDDOffensiveStatsDialog(
            parent=self, operation=calculate, plan_repo=self.repo,
            plan_id=plan_id, stage_key=context_key,
        )
        dialog.exec()
        # Adopt the verified external save so a later Raid Plan save cannot
        # overwrite the newly authored decision with stale note-editor text.
        latest = self.repo.get(plan_id)
        if latest is not None and not self.has_pending_changes():
            self.apply_persisted_plan(latest)
            self._refresh_last_saved_footer()

    def _open_builds(self) -> None:
        opener = getattr(self.window(), "_open_builds", None)
        if callable(opener):
            opener()

    def _edit_selected_player_build(self):
        member = self._selected_member_for_summary()
        if self.current_plan is None or member is None:
            QMessageBox.information(self, 'Edit Build', 'Select an assigned player in a saved Raid Plan first.')
            return
        if not self.flush_pending_changes():
            return
        from ui.components.contextual_build_editor import ContextualBuildEditor
        try:
            dialog = ContextualBuildEditor(self, member.seat_id)
        except (ValueError, RuntimeError, OSError) as exc:
            QMessageBox.warning(self, 'Build editor unavailable', str(exc))
            return
        dialog.exec()
        self._saved_builds_cache = None
        latest = self.repo.get(self.current_plan.plan_id)
        if latest is not None and not self.has_pending_changes():
            self.current_plan = latest
        self._refresh_last_saved_footer()
        self._refresh_selected_build_summary()
        self._refresh_team()
        self._refresh_readiness()
        self._refresh_context_fight_view()
        dialog.deleteLater()

    def _refresh_endgame_roster(self) -> None:
        super()._refresh_endgame_roster()

    def _load_selected_plan(self) -> None:
        super()._load_selected_plan()
        if self.current_plan is not None:
            self._bind_stage_controller(self.current_plan.plan_id)
            self._refresh_summary()

    def _save(self, *, silent: bool = False) -> bool:
        saved = super()._save(silent=silent)
        if saved and self.current_plan is not None:
            self._bind_stage_controller(self.current_plan.plan_id)
            self._refresh_summary()
        return saved

    def _trial_changed(self, value: str) -> None:
        super()._trial_changed(value)
        self._refresh_summary()

    def refresh(self) -> None:
        self._load_plan_choices()
        if self.current_plan is not None and not self.has_pending_changes():
            latest = self.repo.get(self.current_plan.plan_id)
            if latest is not None:
                self.current_plan = latest
        self._refresh_summary()

