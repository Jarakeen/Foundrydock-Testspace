class BannerImage(QFrame):
    """A sharp-edged banner using the existing trial artwork."""

    def __init__(self, parent=None) -> None:
        super().__init__(parent)
        self._source = QPixmap()
        self.setFixedHeight(Metrics.RAID_HEADER_HEIGHT)

    def set_path(self, path: Path | None) -> None:
        self._source = QPixmap(str(path)) if path else QPixmap()
        self.update()

    def paintEvent(self, event) -> None:
        super().paintEvent(event)
        if self._source.isNull():
            return
        scaled = self._source.scaled(
            self.size(), Qt.AspectRatioMode.KeepAspectRatioByExpanding,
            Qt.TransformationMode.SmoothTransformation,
        )
        x = max(0, (scaled.width() - self.width()) // 2)
        # Keep the mountain skyline within the compact panorama crop.
        y = round(max(0, scaled.height() - self.height()) * 0.16)
        painter = QPainter(self)
        painter.drawPixmap(0, 0, scaled.copy(x, y, self.width(), self.height()))
        overlay = QColor(Colors.HEADER_OVERLAY)
        overlay.setAlpha(Colors.HEADER_OVERLAY_ALPHA)
        painter.fillRect(self.rect(), overlay)
        shade = QLinearGradient(0, 0, min(950, self.width()), 0)
        left = QColor(Colors.HEADER_OVERLAY)
        left.setAlpha(Colors.HEADER_LEFT_OVERLAY_ALPHA)
        clear = QColor(Colors.HEADER_OVERLAY); clear.setAlpha(0)
        shade.setColorAt(0, left); shade.setColorAt(0.55, left); shade.setColorAt(1, clear)
        painter.fillRect(self.rect(), shade)
        blend = QLinearGradient(0, max(0, self.height()-Metrics.RAID_HEADER_BLEND_HEIGHT), 0, self.height()-2)
        transparent = QColor(Colors.BACKGROUND); transparent.setAlpha(0)
        blend.setColorAt(0, transparent)
        blend.setColorAt(1, QColor(Colors.BACKGROUND))
        painter.fillRect(self.rect(), blend)
        painter.end()


class HealthTimelineGraph(QWidget):
    """Draw reviewed health thresholds without inventing elapsed-time data."""
    thresholdSelected = Signal(int)

    def __init__(self, parent=None) -> None:
        super().__init__(parent)
        self._markers: list[tuple[int | None, str]] = []
        self.setFixedHeight(Metrics.TIMELINE_HEIGHT)
        self._selected_marker = -1
        self.setFocusPolicy(Qt.FocusPolicy.StrongFocus)
        self.setAccessibleName("Boss health timeline from 100 to zero percent")
        self.setAccessibleDescription('Use Left and Right to select recorded phase thresholds; Enter opens details.')

    def set_phases(self, phases) -> None:
        markers: list[tuple[int | None, str]] = []
        for phase in phases:
            label = str(getattr(phase, "label", "Phase")).strip() or "Phase"
            raw = str(getattr(phase, "threshold", "") or getattr(phase, "marker", "") or "")
            percent_match = re.search(r"(?<!\d)(100|[1-9]?\d)\s*%", raw)
            health_match = re.search(
                r"(?<!\d)(100|[1-9]?\d)\s*(?:boss\s*)?(?:health|hp)\b",
                raw,
                flags=re.IGNORECASE,
            )
            match = percent_match or health_match
            value = int(match.group(1)) if match is not None else None
            markers.append((value, label))
        self._markers = markers
        self._selected_marker = -1
        self.setToolTip('\n'.join(f'{label}: {value if value is not None else "Unknown"}%' for value, label in markers))
        self.update()

    def _marker_x(self, value):
        left, right = 20, self.width() - 21
        return left + round((100 - value) / 100 * (right - left))

    def mousePressEvent(self, event):
        known = [(index, value) for index, (value, _label) in enumerate(self._markers) if value is not None]
        if known and event.button() == Qt.MouseButton.LeftButton:
            index, _value = min(known, key=lambda row: abs(self._marker_x(row[1]) - event.position().x()))
            self._selected_marker = index
            self.thresholdSelected.emit(index)
            self.update()
        super().mousePressEvent(event)

    def keyPressEvent(self, event):
        indices = sorted((i for i, (value, _) in enumerate(self._markers) if value is not None),
                         key=lambda i: -self._markers[i][0])
        if indices and event.key() in (Qt.Key.Key_Left, Qt.Key.Key_Right, Qt.Key.Key_Return, Qt.Key.Key_Space):
            position = indices.index(self._selected_marker) if self._selected_marker in indices else -1
            if event.key() in (Qt.Key.Key_Left, Qt.Key.Key_Right):
                position = (position + (1 if event.key() == Qt.Key.Key_Right else -1)) % len(indices)
            self._selected_marker = indices[max(0, position)]
            self.thresholdSelected.emit(self._selected_marker)
            self.update()
            event.accept()
            return
        super().keyPressEvent(event)

    def paintEvent(self, _event) -> None:
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        from ui.granite_theme import health_timeline_appearance
        style = health_timeline_appearance()
        left, right = self._marker_x(100), self._marker_x(0)
        track = QRectF(left,28,max(1,right-left),12)
        clip = QPainterPath();clip.addRoundedRect(track,5,5)
        painter.fillPath(clip,QColor(style['track']))
        known = sorted({value for value,_label in self._markers if value is not None})
        # Segment only at actual source thresholds. No schematic phase percentages.
        if known:
            boundaries = sorted({0,100,*known})
            painter.save();painter.setClipPath(clip)
            for index,(start,end) in enumerate(zip(boundaries,boundaries[1:])):
                color = QColor(style['bands'][min(index,len(style['bands'])-1)])
                color.setAlpha(190)
                painter.fillRect(QRectF(self._marker_x(end),29,self._marker_x(start)-self._marker_x(end),10),color)
            painter.restore()
        painter.setPen(QColor(style['border']));painter.drawPath(clip)
        painter.setPen(QColor(style['text']))
        painter.drawText(left-2,16,'100%')
        painter.drawText(right-painter.fontMetrics().horizontalAdvance('0%'),16,'0%')
        last_label_right = left+painter.fontMetrics().horizontalAdvance('100%')+6
        for value in reversed(known):
            x = self._marker_x(value)
            active = self._selected_marker >= 0 and self._markers[self._selected_marker][0] == value
            painter.setPen(QColor(style['active'] if active else style['tick']))
            painter.drawLine(x,23,x,48)
            painter.setBrush(QColor(style['active'] if active else style['tick']))
            painter.drawEllipse(QRectF(x-2.5,46,5,5))
            text = f'{value}%'
            text_width = painter.fontMetrics().horizontalAdvance(text)
            text_left = min(max(left, x-text_width//2), right-text_width)
            if value not in (0,100) and text_left > last_label_right+7 and text_left+text_width < right-35:
                painter.setPen(QColor(style['text']))
                painter.drawText(text_left,16,text)
                last_label_right = text_left + text_width
        unknown = sum(value is None for value, _label in self._markers)
        painter.setPen(QColor(style['text']))
        if unknown:
            painter.drawText(left,self.height()-4,f'{unknown} threshold(s) not recorded')
        if not self._markers:
            painter.drawText(left,self.height()-4,'No reviewed phase thresholds recorded')
        painter.end()


class RaidMapPreviewView(QGraphicsView):
    """Inline map preview with wheel zoom and drag panning."""
    zoomChanged = Signal(int)

    def __init__(self, text: str = "", parent=None) -> None:
        self._scene = QGraphicsScene()
        super().__init__(self._scene, parent)
        self._map_item: QGraphicsPixmapItem | None = None
        self._zoom_factor = 1.0
        self._aspect_ratio = 1.0
        self.setFrameShape(QFrame.Shape.NoFrame)
        self.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform, True)
        self.setTransformationAnchor(QGraphicsView.ViewportAnchor.AnchorUnderMouse)
        self.setResizeAnchor(QGraphicsView.ViewportAnchor.AnchorViewCenter)
        self.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.setDragMode(QGraphicsView.DragMode.ScrollHandDrag)
        self.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        self.setVerticalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        self.setBackgroundBrush(QColor(Colors.MAP_CANVAS))
        self.setMinimumSize(0, 0)
        policy = QSizePolicy(QSizePolicy.Policy.Ignored, QSizePolicy.Policy.Preferred)
        policy.setHeightForWidth(True)
        self.setSizePolicy(policy)
        self.setText(text)

    def hasHeightForWidth(self) -> bool:
        return True

    def heightForWidth(self, width: int) -> int:
        return max(1, width)

    def sizeHint(self) -> QSize:
        return QSize(640, self.heightForWidth(640))

    @property
    def zoom_percent(self) -> int:
        return round(self._zoom_factor * 100)

    def setText(self, text: str) -> None:
        self._map_item = None
        self._scene.clear()
        item = self._scene.addText(str(text or ""))
        item.setDefaultTextColor(QColor("#B5B3AF"))
        item.setTextWidth(560)
        bounds = item.boundingRect()
        self._scene.setSceneRect(0, 0, 640, 640)
        item.setPos((640 - bounds.width()) / 2, (640 - bounds.height()) / 2)
        self._aspect_ratio = 1.0
        self._zoom_factor = 1.0
        self.updateGeometry()
        self._fit_scene()

    def setPixmap(self, pixmap: QPixmap) -> None:
        self._scene.clear()
        self._map_item = self._scene.addPixmap(QPixmap(pixmap))
        self._scene.setSceneRect(self._map_item.boundingRect())
        if pixmap.width() > 0 and pixmap.height() > 0:
            self._aspect_ratio = pixmap.width() / pixmap.height()
        self._zoom_factor = 1.0
        self.updateGeometry()
        self._fit_scene()

    def zoom_in(self) -> None:
        self._change_zoom(1.25)

    def zoom_out(self) -> None:
        self._change_zoom(0.8)

    def reset_zoom(self) -> None:
        self._zoom_factor = 1.0
        self._fit_scene()

    def wheelEvent(self, event) -> None:
        if self._map_item is None:
            event.ignore()
            return
        delta = event.angleDelta().y()
        if delta:
            self._change_zoom(1.15 if delta > 0 else 1 / 1.15)
            event.accept()
        else:
            event.ignore()

    def resizeEvent(self, event) -> None:
        super().resizeEvent(event)
        self._fit_scene()

    def _change_zoom(self, multiplier: float) -> None:
        if self._map_item is None:
            return
        next_zoom = min(4.0, max(1.0, self._zoom_factor * multiplier))
        if abs(next_zoom - self._zoom_factor) < 0.001:
            return
        scale_delta = next_zoom / self._zoom_factor
        self._zoom_factor = next_zoom
        self.scale(scale_delta, scale_delta)
        self.zoomChanged.emit(self.zoom_percent)

    def _fit_scene(self) -> None:
        if self.viewport().width() <= 1 or self.viewport().height() <= 1:
            return
        self.resetTransform()
        self.fitInView(self._scene.sceneRect(), Qt.AspectRatioMode.KeepAspectRatio)
        if self._zoom_factor > 1.0:
            self.scale(self._zoom_factor, self._zoom_factor)
        self.zoomChanged.emit(self.zoom_percent)


