    def _selected_context_plan(self):
        """Project saved stage overrides without replacing the editable General plan."""
        baseline = self._draft_plan()
        self._stage_context_unavailable = False
        if baseline is None:
            return None
        import sqlite3
        from services.raid_plan_context_override_repository import RaidPlanContextOverrideRepository
        from services.raid_plan_context_resolver import resolve_raid_plan_context
        try:
            stage = self._selected_stage()
            if stage is None or stage.context_key == "general":
                return baseline
            owner = getattr(self, "_member_context_overrides", None)
            if owner is None:
                owner = RaidPlanContextOverrideRepository(self.repo.path)
                self._member_context_overrides = owner
            override = owner.get(baseline.plan_id, stage.context_key)
            return resolve_raid_plan_context(baseline, override)
        except (OSError, ValueError, sqlite3.Error):
            self._stage_context_unavailable = True
            return None

    def _refresh_team(self) -> None:
        if not hasattr(self, "roster_table"):
            return
        display_plan = self._selected_context_plan()
        members = {_seat_key(member.seat_id): member for member in (display_plan.members if display_plan else ())}
        assigned = 0
        self.roster_table.blockSignals(True)
        for row, seat in enumerate(RAID_PLAN_SEATS):
            member = members.get(_seat_key(seat))
            player = (member.gamertag or member.character_name or "").strip() if member else ""
            assigned += bool(player)
            display_player = player or f"{seat} · Open seat"
            role = member.role if member and member.role else (_seat_role(seat) or "Unknown")
            eso_class = member.eso_class if member and member.eso_class else "Unknown"
            values = (display_player, role, eso_class)
            for col, value in enumerate(values):
                item = QTableWidgetItem(value)
                item.setToolTip(value)
                if col == 0 and player:
                    item.setFont(self.roster_table.font())
                    font = item.font()
                    font.setBold(True)
                    item.setFont(font)
                if col == 0 and not player:
                    item.setForeground(Qt.GlobalColor.gray)
                self.roster_table.setItem(row, col, item)
            first = self.roster_table.item(row, 0)
            first.setData(Qt.ItemDataRole.AccessibleTextRole, f"{display_player}, {role}, {eso_class}, {member.selected_build_name or 'No saved build' if member else 'Open seat'}")
            first.setData(Qt.ItemDataRole.UserRole+1, role)
            first.setData(Qt.ItemDataRole.UserRole+2, eso_class)
            first.setData(Qt.ItemDataRole.UserRole+3, member.selected_build_name if member else "")
            first.setToolTip(f"{display_player} · {role} · {eso_class}\n{member.selected_build_name or 'No saved build' if member else 'Open seat'}")
            self.roster_table.setSpan(row, 0, 1, 3)
            self.roster_table.setRowHeight(row, 46)
        self.roster_table.blockSignals(False)
        self.team_summary.setText(
            "Stage context unavailable · reload the saved plan to retry."
            if self.current_plan is not None and display_plan is None else
            f"{assigned} of 12 players assigned · selected builds are stage references"
        )
        selected_row = next(
            (row for row, seat in enumerate(RAID_PLAN_SEATS)
             if _seat_key(seat) == _seat_key(self._selected_seat_id)),
            -1,
        )
        if selected_row < 0 or selected_row >= len(RAID_PLAN_SEATS):
            selected_row = next(
                (row for row, seat in enumerate(RAID_PLAN_SEATS)
                 if (member := members.get(_seat_key(seat))) is not None
                 and (member.gamertag or member.character_name or member.selected_build_id or member.selected_build_name)),
                0,
            )
        if self.current_plan is not None:
            self._selected_seat_id = RAID_PLAN_SEATS[selected_row]
            self.roster_table.selectRow(selected_row)
        else:
            self._selected_seat_id = ""
            self.roster_table.clearSelection()
        self._filter_roster(getattr(self, "_roster_filter", "all"))
        self._refresh_selected_build_summary()

    def _filter_roster(self, role: str) -> None:
        self._roster_filter = role
        visible = 0
        for row, seat in enumerate(RAID_PLAN_SEATS):
            item = self.roster_table.item(row, 1)
            value = item.text().casefold() if item is not None else _seat_role(seat).casefold()
            matches = role == "all" or (role == "tank" and "tank" in value) or (role == "healer" and "heal" in value) or (role == "dd" and ("dd" in value or "damage" in value))
            self.roster_table.setRowHidden(row, not matches)
            visible += matches
        for key, button in self.roster_filter_buttons.items():
            button.setChecked(key == role)
        # Replace both bounds atomically; a previous short maximum must not clamp
        # the restored All view. Use actual section sizes, not assumed row metrics.
        height = sum(self.roster_table.rowHeight(row) for row in range(self.roster_table.rowCount())
                     if not self.roster_table.isRowHidden(row))
        self.roster_table.setFixedHeight(max(50, height + self.roster_table.frameWidth() * 2 + 4))
        self.roster_table.updateGeometry()
        self.team_panel.layout().invalidate()
        self.team_panel.updateGeometry()
        self._schedule_adaptive_reflow()

    def _selected_member_for_summary(self):
        row = self.roster_table.currentRow()
        if row < 0 or row >= len(RAID_PLAN_SEATS) or self.current_plan is None:
            return None
        self._selected_seat_id = RAID_PLAN_SEATS[row]
        display_plan = self._selected_context_plan()
        return display_plan.member(_seat_key(self._selected_seat_id)) if display_plan else None

    def _saved_build_for_member(self, member):
        if member is None or not member.build_selected:
            return None
        if self._saved_builds_cache is None:
            try:
                from services.build_service import BuildService

                self._saved_builds_cache = list(
                    BuildService(get_data_dir() / "builds.json").load().Members
                )
            except (OSError, RuntimeError, ValueError):
                self._saved_builds_cache = []
        from services.raid_plan_saved_build_resolution_service import RaidPlanSavedBuildResolutionService
        resolution = RaidPlanSavedBuildResolutionService().resolve_member(
            member=member, saved_builds=self._saved_builds_cache,
        )
        return resolution.build if resolution.resolved else None

    def _refresh_selected_build_summary(self) -> None:
        if not hasattr(self, "build_summary_detail"):
            return
        member = self._selected_member_for_summary()
        self.build_summary_warnings.clear()
        self._clear_player_warning_pills()
        self.build_summary_warnings.setStyleSheet("color:#B5B3AF;")
        self.selected_class_emblem.setPixmap(class_emblem_pixmap(member.eso_class if member else "", 24, self.devicePixelRatioF()))
        self.selected_class_emblem.setAccessibleName(f"Class: {member.eso_class if member else 'unknown'}")
        if member is None:
            unavailable = self.current_plan is not None and getattr(self, "_stage_context_unavailable", False)
            self.build_summary_title.setText("Stage context unavailable" if unavailable else "SELECTED BUILD")
            self.build_summary_detail.setText(
                "Could not read saved stage details. Reload the plan to retry."
                if unavailable else "Select a player to see their build basics."
            )
            return
        player = str(member.gamertag or member.character_name or member.seat_id).strip()
        build_name = str(member.selected_build_name or "").strip()
        if not member.build_selected:
            self.build_summary_title.setText(f"{player} · No saved build")
            self.build_summary_detail.setText(
                f"{member.role or 'Role unknown'} · {member.eso_class or 'Class unknown'} · Open Builds to choose a build."
            )
            self._render_player_warning_pills(member, None)
            return
        self.build_summary_title.setText(build_name or "Saved build")
        build = self._saved_build_for_member(member)
        role_class = f"{member.role or 'Role unknown'} · {member.eso_class or 'Class unknown'}"
        if build is None:
            self.build_summary_detail.setText(
                f"{player} · {role_class}\nSaved build details are unavailable here; stage-specific gear and skills remain in Builds."
            )
            self._render_player_warning_pills(member, None)
            return
        gaps = ()
        from services.saved_build_physical_metadata_readiness_service import SavedBuildPhysicalMetadataReadinessService
        try:
            gaps = SavedBuildPhysicalMetadataReadinessService()._gaps(build.to_dict())
        except (ValueError, TypeError, KeyError, AttributeError):
            self.build_summary_warnings.setText("Gear metadata status could not be verified.")
        else:
            if gaps:
                names = ", ".join(f"{gap.slot}: {gap.field}" for gap in gaps[:4])
                more = f" (+{len(gaps)-4} more)" if len(gaps) > 4 else ""
                self.build_summary_warnings.clear()  # Displayed as a clickable pill below.
            else:
                self.build_summary_warnings.clear()
        self._render_player_warning_pills(member, build, gaps)
        baseline_armor = getattr(build, "Armor", {}) or {}
        baseline_sets = []
        for slot in baseline_armor.values():
            if isinstance(slot, dict):
                name = str(slot.get("Set") or "").strip()
                if name and name not in baseline_sets:
                    baseline_sets.append(name)
        baseline_weapons = " / ".join(
            str(getattr(getattr(build, field, None), "WeaponType", "") or "").strip()
            for field in ("FrontBarWeapon", "BackBarWeapon")
        ).strip(" /") or "Not recorded"
        baseline_text = " + ".join(baseline_sets[:3]) or "Sets not recorded"
        from services.build_context_variant_service import resolve_build_context
        stage = self._selected_stage()
        build = resolve_build_context(
            build, team_name=self.current_plan.name,
            boss_name=stage.label if stage is not None and stage.context_key != 'general' else '')
        armor = getattr(build, "Armor", {}) or {}
        gear_sets: list[str] = []
        for slot in armor.values():
            if not isinstance(slot, dict):
                continue
            for key in ("Set", "Set2"):
                value = str(slot.get(key) or "").strip()
                if value and value not in gear_sets:
                    gear_sets.append(value)
        planned_sets = [
            str(value).strip() for value in (getattr(build, "PlannedGearSets", ()) or ())
            if str(value).strip()
        ]
        sets_text = " + ".join(gear_sets[:2]) if gear_sets else " + ".join(planned_sets[:2])
        sets_label = "Sets" if gear_sets else "Planned sets" if planned_sets else "Sets not recorded"
        front = str(getattr(getattr(build, "FrontBarWeapon", None), "WeaponType", "") or "").strip()
        back = str(getattr(getattr(build, "BackBarWeapon", None), "WeaponType", "") or "").strip()
        weapons = " / ".join(value for value in (front, back) if value) or "Weapons not recorded"
        suffix = f"{stage.label if stage else 'Baseline'} · effective saved build. Edit Build to adjust this encounter."
        self.build_summary_detail.setText(
            f"{player} · {role_class}\nBaseline: {baseline_text} · Weapons: {baseline_weapons}\n{sets_label}: {sets_text or 'not recorded'} · Stage weapons: {weapons}\n{suffix}"
        )

    def _clear_player_warning_pills(self):
        while self.player_warning_row.count():
            item = self.player_warning_row.takeAt(0)
            if item.widget() is not None:
                item.widget().deleteLater()

    def _open_player_warning(self, destination: str):
        if destination == "builds":
            self._edit_selected_player_build()
        elif destination == "assignments":
            self._open_stage_assignments_dialog()
            self._refresh_selected_build_summary()
        elif destination == "coverage":
            self._open_coverage_snapshot()
            self._refresh_selected_build_summary()

    def _render_player_warning_pills(self, member, build, gaps=()):
        from services.raid_plan_player_warning_projection import player_warnings
        from services.phase15_assignment_state_service import Phase15AssignmentStateService
        from services.raid_readiness_evidence_service import RaidReadinessEvidenceService
        assignment = None
        readiness_seat = None
        stage = self._selected_stage()
        if stage is not None and self.current_plan is not None:
            assignment = Phase15AssignmentStateService.read_for_stage_snapshot(
                get_user_database_path(), self.current_plan.plan_id, stage.context_key
            )
        if (self.current_plan is not None and member is not None
                and RaidReadinessEvidenceService._assigned_coverage_effects(member)):
            try:
                service = RaidReadinessEvidenceService(
                    data_dir=get_data_dir(), database_path=DEFAULT_DATABASE
                )
                saved = tuple(self._saved_builds_cache or ())
                readiness_seat = service.evaluate(
                    self.current_plan, saved_builds=saved,
                    boss_name=stage.label if stage and stage.context_key != "general" else ""
                ).seat(member.seat_id)
            except (OSError, ValueError, RuntimeError):
                readiness_seat = None
        warnings = player_warnings(
            member=member, build=build, gear_gaps=gaps,
            readiness_seat=readiness_seat, assignment=assignment
        )
        for warning in warnings:
            button = QPushButton(warning.label)
            button.setAccessibleName(warning.label + ": " + warning.detail)
            button.setToolTip(warning.detail + "\nOpen " + warning.destination.title())
            button.setSizePolicy(QSizePolicy.Policy.Minimum, QSizePolicy.Policy.Fixed)
            button.setStyleSheet(
                "QPushButton { border-radius:11px; padding:3px 9px; "
                + ("background:#3C3E43; color:#D8D4CB; border:1px solid #797D7E;"
                   if warning.severity == "review" else
                   "background:#49402E; color:#F7E4B5; border:1px solid #D4B36A;")
                + " }"
            )
            button.clicked.connect(
                lambda _checked=False, dest=warning.destination: self._open_player_warning(dest)
            )
            self.player_warning_row.addWidget(button)
        self.player_warning_row.addStretch(1)

    def _encounter_id(self) -> str:
        stage = self._selected_stage()
        if stage is None or stage.kind != "boss":
            return ""
        return stage.context_key.partition(":")[2]

    def _lokke_import_replay(self):
        selected, _ = QFileDialog.getOpenFileName(
            self, "Import Lokke ESO Logs movement", "", "JSON replay (*.json)",
        )
        if not selected:
            return
        from services.encounter_replay_bundle import import_replay_bundle
        destination = get_user_data_dir() / "encounter_replays" / "lokkestiiz_hm_replay_reference.json"
        try:
            import_replay_bundle(Path(selected), destination, encounter="lokkestiiz")
            if self._lokke_overlay is not None:
                self._lokke_overlay.bundle = None
            self.lokke_logs_layer.setChecked(True)
            self._sync_lokke_layers()
            self._lokke_change_fight()
        except (ValueError, OSError) as exc:
            QMessageBox.warning(self, "Replay import failed", str(exc))

    def _lokke_overlay_controller(self):
        if self._lokke_overlay is None:
            from ui.components.lokke_reference_layer import LokkeReferenceLayer
            try:
                self._lokke_overlay = LokkeReferenceLayer(self)
            except (OSError, ValueError) as exc:
                QMessageBox.warning(self, "Lokke reference unavailable", str(exc))
                return None
        # The inline editor switches the visible canvas from the raster preview
        # to the live board.view. Reference graphics must follow that switch:
        # attaching only to map_image places every marker in a hidden scene.
        board = self.map_surface.board
        showing_editor = (
            board is not None
            and self.map_surface.canvas.currentWidget() is board.view
        )
        target = (
            getattr(board, "_raid_map_background_item", None)
            if showing_editor else self.map_image._map_item
        )
        if target is None:
            self._lokke_overlay.attach(None)
        elif self._lokke_overlay._background is not target:
            self._lokke_overlay.attach(target)
        return self._lokke_overlay

    def _lokke_effective_house_stack_names(self) -> dict[int, str]:
        """Read boss-specific DD assignments, falling back to the plan baseline."""
        if self.current_plan is None:
            return {}
        effective = self.current_plan
        stage = self._selected_stage()
        if stage is not None and stage.context_key == "boss:lokkestiiz":
            from services.raid_plan_effective_context_service import RaidPlanEffectiveContextService
            try:
                state = RaidPlanEffectiveContextService(get_user_database_path()).resolve(
                    self.current_plan.plan_id, stage.context_key,
                )
                effective = state.effective_plan
            except (OSError, ValueError):
                # Existing baseline position assignments remain the fallback.
                pass
        from services.lokke_house_stack_labels import dd_names_from_assignment_jobs
        from services.phase15_assignment_state_service import Phase15AssignmentStateService
        state = None
        if stage is not None:
            state = Phase15AssignmentStateService.read_for_stage_snapshot(
                get_user_database_path(), self.current_plan.plan_id, stage.context_key,
            )
        return dd_names_from_assignment_jobs(effective, state)

    def _sync_lokke_layers(self):
        overlay = self._lokke_overlay_controller()
        if overlay is None:
            return
        overlay.set_house_stack_names(self._lokke_effective_house_stack_names())
        overlay.set_logs_mirrored_x(self.lokke_mirror_logs.isChecked())
        if self.lokke_logs_layer.isChecked() and not overlay.load():
            self.lokke_logs_layer.blockSignals(True)
            self.lokke_logs_layer.setChecked(False)
            self.lokke_logs_layer.blockSignals(False)
            self.map_surface._layers["eso_logs"] = False
            QMessageBox.information(
                self, "ESO Logs reference", "Import the optional Lokke replay JSON using "
                "the reference import workflow before enabling the animated layer."
            )
        overlay.set_visible("movement", self.lokke_logs_layer.isChecked())
        overlay.set_visible("stacks", self.lokke_stacks_layer.isChecked())
        self.lokke_time_slider.setMaximum(
            overlay.fight.duration_ms // 100 if overlay.fight else 2550
        )
        if overlay.fight is not None and overlay.elapsed_ms == 0:
            overlay.set_elapsed(1000)
            self.lokke_time_slider.blockSignals(True)
            self.lokke_time_slider.setValue(10)
            self.lokke_time_slider.blockSignals(False)

    def _lokke_change_fight(self, *_args):
        overlay = self._lokke_overlay_controller() if self.lokke_layer_controls.isVisible() else None
        if overlay is not None and overlay.load():
            overlay.set_route_preview(None)
            overlay.select_fight(int(self.lokke_fight_picker.currentData() or 22))
            self.lokke_time_slider.setRange(0, overlay.fight.duration_ms // 100 if overlay.fight else 0)
            # At time zero none of this report's player observations exists.
            # Start at one second so enabling the layer visibly shows the raid.
            self.lokke_time_slider.setValue(10 if overlay.fight else 0)
            overlay.set_elapsed(self.lokke_time_slider.value() * 100)
            self.lokke_play_button.setText("Play")

    def _lokke_clear_route(self) -> None:
        if self._lokke_overlay is not None:
            self._lokke_overlay.set_route_preview(None)

    def _lokke_preview_route(self) -> None:
        from services.encounter_movement_route_preview import extract_movement_route
        overlay = self._lokke_overlay_controller()
        if overlay is None or not overlay.load() or overlay.bundle is None:
            QMessageBox.information(
                self, "Movement route preview",
                "Import the optional Lokke ESO Logs replay before previewing routes.",
            )
            return
        dialog = QDialog(self)
        dialog.setWindowTitle("Preview observed movement route")
        layout = QVBoxLayout(dialog)
        layout.addWidget(QLabel(
            "Select the recorded actor and time range. Dashed paths are read-only "
            "and never saved to the Raid Plan."
        ))
        fight_picker = QComboBox(dialog)
        for fight in overlay.bundle.fights:
            fight_picker.addItem(f"Fight {fight.id}", fight.id)
        initial_index = fight_picker.findData(
            overlay.fight.id if overlay.fight else overlay.alignment.get("recorded_fight", 37)
        )
        if initial_index >= 0:
            fight_picker.setCurrentIndex(initial_index)
        layout.addWidget(fight_picker)
        actor_picker = QComboBox(dialog)
        layout.addWidget(actor_picker)
        start_seconds = QSpinBox(dialog)
        start_seconds.setPrefix("Start: ")
        start_seconds.setSuffix(" seconds")
        start_seconds.setMinimum(0)
        end_seconds = QSpinBox(dialog)
        end_seconds.setPrefix("End: ")
        end_seconds.setSuffix(" seconds")
        end_seconds.setMinimum(1)
        layout.addWidget(start_seconds)
        layout.addWidget(end_seconds)
        summary = QLabel("No route selected.")
        summary.setWordWrap(True)
        layout.addWidget(summary)
        buttons = QDialogButtonBox(
            QDialogButtonBox.StandardButton.Ok |
            QDialogButtonBox.StandardButton.Cancel,
            parent=dialog,
        )
        buttons.button(QDialogButtonBox.StandardButton.Ok).setText("Preview on map")
        layout.addWidget(buttons)
        buttons.accepted.connect(dialog.accept)
        buttons.rejected.connect(dialog.reject)

        def selected_fight():
            return next(
                (f for f in overlay.bundle.fights if f.id == fight_picker.currentData()), None
            )

        def populate_fight(*_unused):
            fight = selected_fight()
            actor_picker.clear()
            if fight is None:
                return
            for actor in fight.players:
                actor_picker.addItem(f"{actor.role.upper()} · actor {actor.id}", actor.id)
            maximum = max(1, fight.duration_ms // 1000)
            start_seconds.setMaximum(maximum - 1)
            end_seconds.setMaximum(maximum)
            start_seconds.setValue(0)
            end_seconds.setValue(maximum)

        fight_picker.currentIndexChanged.connect(populate_fight)
        populate_fight()
        if dialog.exec() != QDialog.DialogCode.Accepted:
            return
        fight = selected_fight()
        if fight is None:
            return
        actor = next((p for p in fight.players if p.id == actor_picker.currentData()), None)
        if actor is None:
            return
        try:
            preview = extract_movement_route(
                fight, actor, overlay.alignment,
                start_ms=start_seconds.value() * 1000,
                end_ms=min(end_seconds.value() * 1000, fight.duration_ms),
            )
        except ValueError as exc:
            QMessageBox.warning(self, "Movement route preview", str(exc))
            return
        overlay.set_route_preview(preview)
        QMessageBox.information(
            self, "Read-only movement route",
            f"Actor {preview.actor_id} · Fight {preview.fight_id}: "
            f"{len(preview.segments)} contiguous route segments, "
            f"{preview.source_samples} recorded samples, "
            f"{preview.omitted_outside_image} outside the image. "
            "Dashed route preview is not saved. Reopen Preview Route to change the selection.",
        )

