    def _refresh_last_saved_footer(self) -> None:
        """Show the real durable plan save time, not a transient success message."""
        if not hasattr(self, "order_saved_status"):
            return
        plan = self.current_plan
        if plan is None:
            self.order_saved_status.setText("Not saved yet")
            return
        try:
            stored = self.repo.last_saved_at(plan.plan_id)
            if stored is None:
                label = "Save time unavailable"
            else:
                # SQLite CURRENT_TIMESTAMP is UTC. Display in the computer's timezone.
                from ui.phase15_save_feedback import format_plan_saved_at
                label = format_plan_saved_at(stored)
        except (OSError, ValueError, sqlite3.Error):
            label = "Save time unavailable"
        if self.has_pending_changes():
            label = "Unsaved changes · " + label
        self.order_saved_status.setText(label)

