    def _scale_map_image(self) -> None:
        if getattr(self, "_map_source", QPixmap()).isNull():
            return
        self.map_image.setPixmap(self._map_source)
        if self._lokke_overlay is not None:
            if self.lokke_layer_controls.isVisible():
                # A live editor may still be on screen. Do not attach to its
                # hidden preview when rebuilding the raster image.
                controller = self._lokke_overlay_controller()
                if controller is not None:
                    controller.set_visible("movement", self.lokke_logs_layer.isChecked())
                    controller.set_visible("stacks", self.lokke_stacks_layer.isChecked())
            else:
                self._lokke_overlay.attach(None)

    def _guide_for(self, encounter_id: str):
        if not encounter_id:
            return None
        try:
            stat = DEFAULT_DATABASE.stat()
            revision = (encounter_id.casefold(), stat.st_mtime_ns, stat.st_size)
        except OSError:
            return None
        if revision not in self._guide_cache:
            try:
                self._guide_cache.clear()
                self._guide_cache[revision] = EncounterBossGuideService(DEFAULT_DATABASE).get(encounter_id)
            except (EncounterBossGuideError, LookupError, ValueError):
                self._guide_cache[revision] = None
        return self._guide_cache[revision]

    def _timeline_evidence_for(self, encounter_id: str, encounter_name: str):
        key = str(encounter_id or "").strip().casefold()
        if key not in self._timeline_projection_cache:
            try:
                from services.encounter_guide_evidence_projection_service import (
                    EncounterGuideEvidenceProjectionService,
                )

                data_root = Path(DEFAULT_DATABASE).parent
                self._timeline_projection_cache[key] = EncounterGuideEvidenceProjectionService(
                    data_root
                ).get(encounter_id, encounter_name)
            except (OSError, RuntimeError, ValueError):
                self._timeline_projection_cache[key] = None
        return self._timeline_projection_cache[key]

    def _refresh_timeline(self) -> None:
        if not hasattr(self, "timeline_list"):
            return
        self.timeline_list.clear()
        self.timeline_graph.show()
        self._timeline_phase_records = []
        self._clear_layout_widgets(self.timeline_cards_layout)
        encounter_id = self._encounter_id()
        layers = self.map_surface.package_layers
        if not encounter_id:
            self.timeline_list.addItem("No boss-specific phase timeline for this stage.")
            self.timeline_graph.set_phases(())
            self.timeline_note.setText("Select a boss stage to review its phase thresholds and timing evidence.")
            self.timeline_selection_detail.setText("No boss-specific thresholds are available for this stage.")
            self._refresh_phase_buttons(())
            self._schedule_adaptive_reflow()
            return
        guide = self._guide_for(encounter_id)
        guide_name = guide.name if guide is not None else encounter_id.replace("_", " ").title()
        phases = (guide.phases or guide.structural_phases) if guide is not None else ()
        used_evidence_fallback = False
        if not phases:
            projection = self._timeline_evidence_for(encounter_id, guide_name)
            phases = getattr(projection, "timeline", ()) if projection is not None else ()
            used_evidence_fallback = bool(phases)
        for phase in phases[:12]:
            label = str(getattr(phase, "label", "Phase") or "Phase").strip()
            marker = str(
                getattr(phase, "marker", "") if used_evidence_fallback
                else getattr(phase, "threshold", "")
            ).strip()
            marker = marker if marker and marker != "?" else "Threshold unknown"
            if marker != "Threshold unknown" and re.search(r"\d\s*%",marker) and "health" not in marker.casefold():
                marker = f"{marker} health"
            description = str(
                getattr(phase, "detail", "") if used_evidence_fallback
                else getattr(phase, "description", "")
            ).strip()
            detail = description or "No further phase detail is recorded."
            plain_item = QListWidgetItem(f"{label}  ·  {marker}")
            plain_item.setToolTip(detail)
            self.timeline_list.addItem(plain_item)
            self._timeline_phase_records.append((phase, label, marker, detail))
        if not phases:
            message = (
                "Reviewed phase evidence is unavailable."
                if guide is None
                else "No phase markers are recorded for this encounter."
            )
            self.timeline_list.addItem(message)
        from ui.components.raid_fight_presentation import is_downtime,mechanic_marker
        lower=list(range(len(self._timeline_phase_records)))
        names={self._timeline_phase_records[index][1].casefold() for index in lower}
        if guide is not None:
            for ability in getattr(guide,"abilities",())[:24]:
                if is_downtime(ability) or ability.name.casefold() in names:continue
                names.add(ability.name.casefold())
                self._timeline_phase_records.append((ability,ability.name,mechanic_marker(ability),ability.description or 'No further detail recorded.'))
                lower.append(len(self._timeline_phase_records)-1)
        def threshold_order(index):
            match=re.search(r'(?<!\d)(100|[1-9]?\d)\s*%',self._timeline_phase_records[index][2])
            return -int(match.group(1)) if match else 101
        lower.sort(key=threshold_order)
        for position,index in enumerate(lower):
            _phase,label,marker,detail=self._timeline_phase_records[index]
            card=QPushButton(self.timeline_cards_widget);card.setCheckable(True)
            card.setProperty('timelinePhaseCard',True);card.setProperty('timelineRecordIndex',index)
            known_marker = marker not in ('Threshold not recorded', 'Threshold unknown')
            card.setAccessibleName(f'{label}: {marker}' if known_marker else label);card.setToolTip(detail)
            contents=QVBoxLayout(card);contents.setContentsMargins(8,8,8,8);contents.setSpacing(5)
            policy=QSizePolicy(QSizePolicy.Policy.Preferred,QSizePolicy.Policy.Minimum)
            policy.setHeightForWidth(True);card.setSizePolicy(policy)
            marker_row=QHBoxLayout();marker_row.setSpacing(5)
            icon=QLabel();icon.setPixmap(self._workspace_icon('mechanics').pixmap(18,18))
            icon.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents,True);marker_row.addWidget(icon)
            marker_caption=QLabel(marker);marker_caption.setWordWrap(True);marker_caption.setProperty('mechanicCardMarker',True)
            marker_caption.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents,True);marker_row.addWidget(marker_caption,1)
            icon.setVisible(known_marker);marker_caption.setVisible(known_marker)
            contents.addLayout(marker_row)
            for text,prop in ((label,'mechanicCardTitle'),):
                caption=QLabel(text);caption.setWordWrap(True);caption.setProperty(prop,True)
                caption.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents,True);contents.addWidget(caption)
            summary=QLabel(detail.split('. ')[0][:180])
            summary.setWordWrap(True);summary.setProperty('mechanicCardSummary',True)
            summary.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents,True)
            contents.addWidget(summary);contents.addStretch(1)
            card.clicked.connect(lambda _checked=False,card_index=index:self._select_timeline_phase(card_index))
            self.timeline_cards_layout.addWidget(card,position//4,position%4)
        if lower:
            if self.map_surface.package_layers.package is None:self._select_timeline_phase(lower[0])
            else:self.timeline_selection_detail.setText('Select a health threshold to show its map phase, or a named attack to review its mechanic and assignments.')
        else:
            empty=QLabel('No other mechanic records are available for this encounter.')
            empty.setWordWrap(True);self.timeline_cards_layout.addWidget(empty,0,0)
        self.timeline_graph.set_phases(phases or ())
        if used_evidence_fallback:
            self.timeline_note.setText(
                "Reviewed boss-health thresholds. Elapsed seconds from pull start are not recorded."
            )
        elif guide is not None and guide.source_url:
            self.timeline_note.setText(
                f"Source: {guide.source_page_title or guide.source_url} · revision "
                f"{guide.source_revision_id or 'unknown'}. Source record; review status is not recorded here. Health thresholds and elapsed pull time are separate facts."
            )
        else:
            self.timeline_note.setText(
                "Encounter records · review status not recorded here. Health thresholds and elapsed seconds from pull start are tracked separately."
            )
        self._refresh_phase_buttons(phases or ())
        self._schedule_adaptive_reflow()

    def _select_timeline_phase(self, index: int) -> None:
        if index < 0 or index >= len(self._timeline_phase_records):
            return
        _phase, label, marker, detail = self._timeline_phase_records[index]
        layers = self.map_surface.package_layers
        if layers.package is not None and layers.sections and isinstance(_phase, int):
            layers.seek(_phase)
            self.timeline_selection_detail.setText(f'{label} · {marker}\n{detail}')
            return
        layers.select_encounter_phase(label, marker)
        picker = getattr(self, 'package_phase_picker', None)
        if layers.package is not None and picker is not None:
            picker.blockSignals(True)
            picker.setCurrentIndex(picker.findData(layers.phase))
            picker.blockSignals(False)
        self.timeline_graph._selected_marker = index if index < len(self.timeline_graph._markers) else -1
        self.timeline_graph.update()
        from ui.components.raid_fight_context import stage_assignments, mechanic_jobs
        try:
            assignment_detail = mechanic_jobs(self, stage_assignments(self), label)
        except (OSError, RuntimeError, ValueError, sqlite3.Error):
            assignment_detail = 'Stage assignments could not be read.'
        self.timeline_selection_detail.setText(f"{label} · {marker}\n{detail}\n{assignment_detail}")
        self.timeline_selection_detail.setTextFormat(Qt.TextFormat.PlainText)
        for card_index in range(self.timeline_cards_layout.count()):
            card = self.timeline_cards_layout.itemAt(card_index).widget()
            if isinstance(card, QPushButton) and card.property("timelinePhaseCard"):
                card.setChecked(card.property("timelineRecordIndex") == index)

    def _refresh_phase_buttons(self, phases) -> None:
        if not hasattr(self, "phase_button_layout"):
            return
        while self.phase_button_layout.count():
            item = self.phase_button_layout.takeAt(0)
            if item.widget() is not None:
                item.widget().deleteLater()
        self._flight_phases = []
        package = self.map_surface.package_layers.package
        self.package_phase_picker = None
        if package is not None:
            headings = sorted(((key, value) for key, value in package.phase_bindings.items() if key.endswith('%') and (not package.heading_thresholds or key in package.heading_thresholds)), key=lambda row:int(row[0][:-1]), reverse=True)
            self._package_heading_phases = [value for key,value in headings]
            for index,(threshold,phase) in enumerate(headings):
                button = QPushButton(threshold,self.phase_button_bar)
                button.setCheckable(True)
                button.setAccessibleName(f'{phase} · {threshold}')
                button.clicked.connect(lambda checked=False, selected=index:self._select_flight_phase(selected))
                self.phase_button_layout.addWidget(button)
                self._flight_phases.append((phase,index))
            self.phase_button_bar.setVisible(bool(headings))
            return
        if not phases:
            self.phase_button_bar.hide()
            return
        for timeline_index, phase in enumerate(phases[:12]):
            label = str(getattr(phase, "label", "")).strip()
            from ui.components.raid_fight_presentation import is_downtime
            if not is_downtime(phase):continue
            if len(self._flight_phases) >= 3:
                break
            row = self.timeline_list.item(timeline_index)
            if row is None:
                continue
            marker = row.text().partition("·")[2].strip() if row is not None else ""
            phase_index = len(self._flight_phases)
            button = QPushButton((f"Flight {phase_index + 1}" if "flight" in label.casefold() else label) + (f" · {marker.replace(chr(32)+"health","")}" if marker else ""))
            button.setCheckable(True)
            button.setFixedHeight(Metrics.FIGHT_PHASE_HEIGHT)
            button.setMinimumWidth(0)
            button.setToolTip(row.toolTip() or row.text())
            button.setProperty("phaseControl", True)
            button.clicked.connect(
                lambda _checked=False, index=phase_index: self._select_flight_phase(index)
            )
            self.phase_button_layout.addWidget(button, 0)
            button.ensurePolished();button.setFixedHeight(Metrics.FIGHT_PHASE_HEIGHT)
            self._flight_phases.append((phase, timeline_index))
        self.phase_button_bar.setVisible(bool(self.phase_button_layout.count()))

    def _package_cursor_changed(self, phase, milliseconds):
        layers = self.map_surface.package_layers
        if layers.package is None:return
        stage=self._selected_stage()
        self.fight_stage_caption.setText(f'{stage.label if stage else "Encounter"} · {phase} · {layers.format_time(milliseconds)}')
        key=(self.current_plan.plan_id,phase,layers.teaching_cue)
        if key == getattr(self,'_package_cursor_key',None):return
        self._package_cursor_key=key
        section_index=next((i for i,row in enumerate(layers.sections) if row.phase==phase),0)
        chapter = -1
        for index, heading_phase in enumerate(getattr(self, '_package_heading_phases', ())):
            heading_index = next((i for i,row in enumerate(layers.sections) if row.phase==heading_phase),len(layers.sections))
            if heading_index <= section_index:chapter=index
        for i in range(self.phase_button_layout.count()):
            button=self.phase_button_layout.itemAt(i).widget()
            if isinstance(button,QPushButton):button.setChecked(i==chapter)
        self._refresh_context_fight_view()

    def _select_package_phase(self, _index):
        picker = self.package_phase_picker
        layers = self.map_surface.package_layers
        if picker is None or layers.package is None:return
        phase = str(picker.currentData() or '')
        layers.select_encounter_phase(phase)
        stage = self._selected_stage()
        self.fight_stage_caption.setText(f"{stage.label if stage else 'Encounter'} · {phase}")
        self.timeline_graph._selected_marker = -1
        self.timeline_graph.update()
        for index in range(self.timeline_cards_layout.count()):
            card = self.timeline_cards_layout.itemAt(index).widget()
            if isinstance(card, QPushButton) and card.property('timelinePhaseCard'):card.setChecked(False)

    def _select_flight_phase(self, index: int) -> None:
        if index < 0 or index >= len(self._flight_phases):
            return
        _phase, _timeline_index = self._flight_phases[index]
        layers = self.map_surface.package_layers
        if layers.package is not None:
            layers.select_encounter_phase(self._package_heading_phases[index])
            return
        stage=self._selected_stage()
        self.fight_stage_caption.setText(f"{stage.label if stage else 'Encounter'} · {getattr(_phase,'label','Phase')}")
        self._select_timeline_phase(_timeline_index);self._set_fight_view('timeline')
        for button_index in range(self.phase_button_layout.count()):
            self.phase_button_layout.itemAt(button_index).widget().setChecked(button_index==index)
        if self.map_surface.package_layers.package is not None:
            return  # Encounter phase selection already filtered the package layers.
        number = index + 1
        match_terms = (
            f"flight {number}", f"flight phase {number}",
            f"phase {number} flight", f"flight {('one', 'two', 'three')[index]}",
        )
        candidate = next(
            (
                (path, label) for path, label in self._available_stage_maps
                if any(term in label.casefold() for term in match_terms)
                and path.resolve() != self._selected_map_path
            ),
            None,
        )
        if candidate is None:return
        path, label = candidate
        pixmap = QPixmap(str(path))
        if pixmap.isNull():
            button = self.phase_button_layout.itemAt(index).widget()
            if button is not None:
                button.setChecked(False)
            return
        self._selected_map_path = path.resolve()
        self._map_source = pixmap
        self._scale_map_image()
        for button_index in range(self.phase_button_layout.count()):
            button = self.phase_button_layout.itemAt(button_index).widget()
            if button is not None:
                button.setChecked(button_index == index)

