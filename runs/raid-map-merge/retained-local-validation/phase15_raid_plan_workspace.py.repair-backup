    def _header_team_activated(self, index: int) -> None:
        """Reuse existing plan loader; never synthesize or overwrite plans."""
        if index < 0:
            return
        plan_id = self.header_team_selector.itemData(index)
        if plan_id == "__new__":
            self._new_plan()
            self._show_new_plan_fields()
            return
        if not plan_id:
            return
        if self.has_pending_changes():
            QMessageBox.information(self, "Unsaved Raid Plan", "Save your current plan before changing teams.")
            self._refresh_header_team_choices()
            return
        idx = self.plan_combo.findData(plan_id)
        if idx < 0:
            return
        self.plan_combo.setCurrentIndex(idx)
        self._load_selected_plan()

    def _refresh_header_team_choices(self) -> None:
        if not hasattr(self, "header_team_selector"):
            return
        combo = self.header_team_selector
        current_id = self.current_plan.plan_id if self.current_plan is not None else None
        combo.blockSignals(True)
        combo.clear()
        combo.addItem("Choose a team", None)
        try:
            plans = tuple(self.repo.list_plans())
        except (OSError, ValueError, RuntimeError, sqlite3.Error):
            plans = ()
        for plan in plans:
            combo.addItem(plan.team_name or plan.name, plan.plan_id)
        combo.insertSeparator(combo.count())
        combo.addItem("＋ New Plan", "__new__")
        if current_id is not None:
            index = combo.findData(current_id)
            if index >= 0:
                combo.setCurrentIndex(index)
        combo.blockSignals(False)

    def _load_plan_choices(self) -> None:
        self._refresh_header_team_choices()
        self.plan_combo.clear()
        self.plan_combo.addItem("Choose a saved plan…", None)
        try:
            for plan in self.repo.list_plans():
                self.plan_combo.addItem(plan.name, plan.plan_id)
        except Exception:
            self.plan_combo.addItem("Saved plans unavailable", None)

