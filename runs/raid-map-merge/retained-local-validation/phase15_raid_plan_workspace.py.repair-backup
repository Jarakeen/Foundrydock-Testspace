class RaidPlanQuickEntryDialog(QDialog):
    """Compact editor for the active plan's twelve raid seats."""

    _ROLES = ("", "Tank", "Healer", "DD", "Support DD")
    _CLASSES = (
        "", "Arcanist", "Dragonknight", "Necromancer", "Nightblade",
        "Sorcerer", "Templar", "Warden",
    )

    def __init__(self, plan, parent=None) -> None:
        super().__init__(parent)
        self._plan = plan
        self.setWindowTitle("Quick Entry · Raid Team")
        self.setModal(True)
        self.resize(760, 540)
        layout = QVBoxLayout(self)
        heading = QLabel(f"TEAM QUICK ENTRY · {plan.name}")
        heading.setProperty("eyebrow", True)
        layout.addWidget(heading)
        note = QLabel(
